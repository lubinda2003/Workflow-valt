---
export interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="tool-tag">{label}</span>

<style>
  .tool-tag {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    padding: .25rem .6rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
</style>
