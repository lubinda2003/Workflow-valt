---
import Badge from "./Badge.astro";
import ToolTag from "./ToolTag.astro";

export interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  difficulty: string;
  readingTime: string;
  tools: string[];
  cover?: string;
}

const { slug, title, description, category, difficulty, readingTime, tools = [], cover } = Astro.props;
---

<a href={`/workflows/${slug}`} class="card workflow-card">
  <div class="cover">
    {cover && <img src={cover} alt="" loading="lazy" onerror="this.remove()" />}
    <div class="cover-fallback" aria-hidden="true">
      <div class="circuit-grid"></div>
      <div class="pipeline-preview-mini">
        <span class="mini-node trigger"></span>
        <span class="mini-line"></span>
        <span class="mini-node process"></span>
        <span class="mini-line"></span>
        <span class="mini-node storage"></span>
      </div>
    </div>
    <div class="cover-overlay"></div>
  </div>

  <div class="card-content">
    <div class="card-top">
      <span class="category-pill">{category}</span>
      <Badge label={difficulty} tone="auto" />
    </div>

    <h3>{title}</h3>
    <p>{description}</p>

    <div class="tools">
      {tools.slice(0, 3).map((tool) => <ToolTag label={tool} />)}
      {tools.length > 3 && (
        <span class="more-tools">+{tools.length - 3}</span>
      )}
    </div>

    <div class="card-bottom">
      <div class="meta-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span class="reading-time">{readingTime} read</span>
      </div>

      <span class="link">
        <span>Inspect</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .workflow-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    position: relative;
  }

  .workflow-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform var(--transition);
  }

  .workflow-card:hover .cover img {
    transform: scale(1.04);
  }

  .cover-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f121a 0%, #161a24 100%);
  }

  .circuit-grid {
    position: absolute;
    inset: 0;
    background-size: 20px 20px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  }

  .pipeline-preview-mini {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: rgba(9, 10, 15, 0.7);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    backdrop-filter: blur(4px);
    box-shadow: var(--specular);
  }

  .mini-node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .mini-node.trigger { background: var(--text-subtle); }
  .mini-node.process { background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .mini-node.storage { background: #10b981; }

  .mini-line {
    width: 16px;
    height: 1.5px;
    background: var(--border-strong);
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    box-shadow: inset 0 -20px 30px -10px var(--surface);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.25rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .category-pill {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workflow-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    color: var(--text);
    transition: color var(--transition);
  }

  .workflow-card:hover h3 {
    color: #ffffff;
  }

  .workflow-card p {
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--text-muted);
    flex-grow: 1;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .more-tools {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-subtle);
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    border-radius: var(--radius-xs);
  }

  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--fs-2xs);
    color: var(--text-muted);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-subtle);
  }

  .reading-time {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--accent);
    font-weight: 600;
    transition: var(--transition);
  }

  .workflow-card:hover .link {
    color: var(--accent-hover);
    transform: translateX(2px);
  }
</style>
