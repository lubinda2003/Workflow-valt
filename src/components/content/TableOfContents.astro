---
export interface Props {
  items: Array<{ id: string; label: string }>;
}

const { items } = Astro.props;
---

<aside class="toc toc-desktop" aria-label="Table of contents">
  <p class="toc-label">On This Page</p>
  <nav>
    <ul>
      {items.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</aside>

<details class="toc toc-mobile">
  <summary>On This Page</summary>
  <nav>
    <ul>
      {items.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</details>

<style>
  .toc-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: var(--space-2);
  }

  .toc-desktop {
    position: sticky;
    top: calc(78px + var(--space-3));
    align-self: start;
  }

  .toc-desktop nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .6rem;
    border-left: 1px solid var(--border);
  }

  .toc-desktop nav a {
    display: block;
    padding: .2rem 0 .2rem var(--space-3);
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    transition: var(--transition);
  }

  .toc-desktop nav a:hover {
    color: var(--text);
    border-left-color: var(--accent);
  }

  .toc-mobile {
    display: none;
  }

  .toc-mobile summary {
    cursor: pointer;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    padding: .9rem var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .toc-mobile[open] summary {
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .toc-mobile nav {
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }

  .toc-mobile nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .toc-mobile nav a {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .toc-mobile nav a:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
      margin-bottom: var(--space-4);
    }
  }
</style>
