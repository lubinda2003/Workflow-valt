---
export interface Props {
  items: Array<{ id: string; label: string }>;
  stepCount?: number;
}

const { items, stepCount = 0 } = Astro.props;
---

<aside class="toc-sidebar toc-desktop" aria-label="Table of contents">
  <div class="toc-card">
    <div class="toc-header">
      <div class="toc-title-row">
        <span class="toc-label">NAVIGATE GUIDE</span>
        <span class="toc-indicator-dot"></span>
      </div>
      <span class="toc-sub">Quick jump &amp; live tracker</span>
    </div>

    <!-- Live Step Progress in Sticky Desktop Sidebar -->
    {stepCount > 0 && (
      <div class="sidebar-progress-box">
        <div class="sidebar-prog-top">
          <span class="sidebar-prog-label">Step Progress</span>
          <span class="sidebar-prog-val" id="sidebar-progress-text">0/{stepCount} done</span>
        </div>
        <div class="sidebar-prog-track">
          <div class="sidebar-prog-fill" id="sidebar-progress-fill" style="width: 0%"></div>
        </div>
      </div>
    )}

    <nav class="toc-nav">
      <ul class="toc-list">
        {items.map((item) => (
          <li class="toc-item">
            <a href={`#${item.id}`} class="toc-link" data-target={item.id}>
              <span class="toc-dot"></span>
              <span class="toc-text">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="toc-footer">
      <button type="button" class="back-to-top-btn" id="toc-back-to-top" title="Scroll back to top of guide">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
        <span>Back to top</span>
      </button>

      <div class="toc-kbd-tip">
        <kbd class="kbd-key">J</kbd><kbd class="kbd-key">K</kbd>
        <span>to jump steps</span>
      </div>
    </div>
  </div>
</aside>

<!-- Mobile Collapsible Table of Contents -->
<details class="toc-mobile">
  <summary>
    <div class="mobile-summary-left">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="8" y1="6" x2="21" y2="6"></line>
        <line x1="8" y1="12" x2="21" y2="12"></line>
        <line x1="8" y1="18" x2="21" y2="18"></line>
        <line x1="3" y1="6" x2="3.01" y2="6"></line>
        <line x1="3" y1="12" x2="3.01" y2="12"></line>
        <line x1="3" y1="18" x2="3.01" y2="18"></line>
      </svg>
      <span>Table of Contents</span>
    </div>
    <span class="mobile-summary-pill">{items.length} Sections</span>
  </summary>
  <nav class="mobile-nav">
    <ul>
      {items.map((item) => (
        <li><a href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</details>

<script>
  function setupTocUtilities() {
    const backToTopBtn = document.getElementById("toc-back-to-top");
    if (backToTopBtn) {
      backToTopBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // Keyboard navigation J / K between guide sections or steps
    document.addEventListener("keydown", (e) => {
      // Ignore if user is typing in an input/textarea
      const activeTag = document.activeElement?.tagName.toLowerCase();
      if (activeTag === "input" || activeTag === "textarea" || activeTag === "select") return;

      if (e.key === "j" || e.key === "J") {
        const sections = Array.from(document.querySelectorAll<HTMLElement>(".guide-section[id], .step[id]"));
        const scrollPos = window.scrollY + 120;
        const next = sections.find((s) => s.offsetTop > scrollPos);
        if (next) {
          next.scrollIntoView({ behavior: "smooth" });
        }
      } else if (e.key === "k" || e.key === "K") {
        const sections = Array.from(document.querySelectorAll<HTMLElement>(".guide-section[id], .step[id]"));
        const scrollPos = window.scrollY + 80;
        const prev = sections.slice().reverse().find((s) => s.offsetTop < scrollPos - 20);
        if (prev) {
          prev.scrollIntoView({ behavior: "smooth" });
        }
      } else if (e.key === "t" || e.key === "T") {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  }

  setupTocUtilities();
  document.addEventListener("astro:page-load", setupTocUtilities);
</script>

<style>
  .toc-desktop {
    position: sticky;
    top: 96px;
    align-self: start;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .toc-desktop::-webkit-scrollbar {
    width: 4px;
  }

  .toc-desktop::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 4px;
  }

  .toc-card {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .toc-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .toc-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.15rem;
  }

  .toc-label {
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .toc-sub {
    font-size: var(--fs-2xs);
    color: var(--text-subtle);
  }

  .sidebar-progress-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    padding: 0.65rem 0.75rem;
  }

  .sidebar-prog-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-2xs);
    font-family: var(--font-mono);
    margin-bottom: 0.4rem;
  }

  .sidebar-prog-label {
    color: var(--text-subtle);
    font-weight: 600;
  }

  .sidebar-prog-val {
    color: var(--accent);
    font-weight: 700;
  }

  .sidebar-prog-track {
    width: 100%;
    height: 5px;
    background: var(--surface);
    border-radius: 999px;
    overflow: hidden;
  }

  .sidebar-prog-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #34d399);
    border-radius: 999px;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-nav {
    margin: 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-xs);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition: var(--transition);
    border-left: 2px solid transparent;
  }

  .toc-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-subtle);
    transition: var(--transition);
    flex-shrink: 0;
  }

  .toc-text {
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toc-link:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  .toc-link.active {
    color: var(--text);
    font-weight: 700;
    background: var(--surface-hover);
    border-left-color: var(--accent);
  }

  .toc-link.active .toc-dot {
    background: var(--accent);
    transform: scale(1.4);
    box-shadow: 0 0 6px var(--accent);
  }

  .toc-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: 100%;
    padding: 0.45rem 0.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text-muted);
    font-size: var(--fs-2xs);
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
  }

  .back-to-top-btn:hover {
    background: var(--surface-hover);
    color: var(--text);
    border-color: var(--border-strong);
  }

  .toc-kbd-tip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.6875rem;
    color: var(--text-subtle);
    font-family: var(--font-mono);
  }

  .kbd-key {
    padding: 0.1rem 0.35rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-muted);
    font-size: 0.625rem;
  }

  /* Mobile TOC */
  .toc-mobile {
    display: none;
  }

  @media (max-width: 960px) {
    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
      margin-bottom: 1.75rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      overflow: hidden;
    }

    .toc-mobile summary {
      cursor: pointer;
      padding: 0.9rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: var(--fs-xs);
      font-weight: 700;
      color: var(--text);
      list-style: none;
    }

    .toc-mobile summary::-webkit-details-marker {
      display: none;
    }

    .mobile-summary-left {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text);
    }

    .mobile-summary-pill {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.15rem 0.45rem;
      border-radius: var(--radius-xs);
    }

    .mobile-nav {
      padding: 0.75rem 1.25rem 1.25rem;
      border-top: 1px solid var(--border-subtle);
    }

    .mobile-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .mobile-nav a {
      color: var(--text-muted);
      font-size: var(--fs-sm);
      text-decoration: none;
    }

    .mobile-nav a:hover {
      color: var(--accent);
    }
  }
</style>
