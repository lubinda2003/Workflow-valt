---
import ToolTag from "./ToolTag.astro";

export interface Props {
  tools: string[];
  label?: string;
}

const { tools, label = "Tools used" } = Astro.props;
---

<div class="tool-list">
  <p class="tool-list-label">{label}</p>
  <div class="tool-list-items">
    {tools.map((tool) => <ToolTag label={tool} />)}
  </div>
</div>

<style>
  .tool-list-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: var(--space-2);
  }

  .tool-list-items {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
</style>
