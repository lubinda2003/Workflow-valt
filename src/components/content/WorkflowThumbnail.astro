---
export interface Props {
  slug: string;
  category: string;
  tools: string[];
  difficulty: string;
}

const { slug, category, tools = [], difficulty } = Astro.props;

// Determine color scheme & schematic icons based on slug/category
interface ThemeConfig {
  accentColor: string;
  accentGlow: string;
  bgGradient: string;
  sourceNode: { icon: string; label: string };
  midNode: { icon: string; label: string };
  destNode: { icon: string; label: string };
  badgeText: string;
}

function getTheme(slug: string, category: string, tools: string[]): ThemeConfig {
  if (slug === "n8n-docker-caddy") {
    return {
      accentColor: "#f97316",
      accentGlow: "rgba(249, 115, 22, 0.4)",
      bgGradient: "linear-gradient(135deg, #130f0a 0%, #1c150c 50%, #0d0f17 100%)",
      sourceNode: { icon: "DOCKER", label: "Docker" },
      midNode: { icon: "CADDY", label: "Auto-SSL" },
      destNode: { icon: "N8N", label: "n8n Core" },
      badgeText: "CONTAINER STACK"
    };
  }

  if (slug === "stripe-webhook-postgres-sync") {
    return {
      accentColor: "#6366f1",
      accentGlow: "rgba(99, 102, 241, 0.4)",
      bgGradient: "linear-gradient(135deg, #0d0e1d 0%, #15162e 50%, #0d1217 100%)",
      sourceNode: { icon: "STRIPE", label: "Stripe" },
      midNode: { icon: "HMAC", label: "SHA-256" },
      destNode: { icon: "PGSQL", label: "Postgres" },
      badgeText: "HMAC VERIFIED"
    };
  }

  if (slug === "claude-notion-summaries") {
    return {
      accentColor: "#d97706",
      accentGlow: "rgba(217, 119, 6, 0.4)",
      bgGradient: "linear-gradient(135deg, #18120b 0%, #241b0d 50%, #0d1017 100%)",
      sourceNode: { icon: "AUDIO", label: "Audio/Text" },
      midNode: { icon: "CLAUDE", label: "Claude 3.5" },
      destNode: { icon: "NOTION", label: "Notion DB" },
      badgeText: "LLM PIPELINE"
    };
  }

  if (slug === "cloudflare-rate-limit") {
    return {
      accentColor: "#06b6d4",
      accentGlow: "rgba(6, 182, 212, 0.4)",
      bgGradient: "linear-gradient(135deg, #09151c 0%, #0d222e 50%, #0c1117 100%)",
      sourceNode: { icon: "EDGE", label: "Edge Req" },
      midNode: { icon: "WORKER", label: "CF Worker" },
      destNode: { icon: "KV", label: "KV Storage" },
      badgeText: "EDGE DEFENSE"
    };
  }

  if (slug === "ocr-receipts-sheets") {
    return {
      accentColor: "#10b981",
      accentGlow: "rgba(16, 185, 129, 0.4)",
      bgGradient: "linear-gradient(135deg, #081712 0%, #0e241c 50%, #0c1117 100%)",
      sourceNode: { icon: "DOC", label: "Receipt" },
      midNode: { icon: "OCR", label: "Vision AI" },
      destNode: { icon: "SHEETS", label: "GSpy Sheets" },
      badgeText: "DOCUMENT OCR"
    };
  }

  if (slug === "github-actions-deploy") {
    return {
      accentColor: "#3b82f6",
      accentGlow: "rgba(59, 130, 246, 0.4)",
      bgGradient: "linear-gradient(135deg, #091220 0%, #0f1e36 50%, #0c1117 100%)",
      sourceNode: { icon: "GIT", label: "Git Push" },
      midNode: { icon: "RUNNER", label: "CI Runner" },
      destNode: { icon: "VPS", label: "VPS SSH" },
      badgeText: "CI/CD PIPELINE"
    };
  }

  if (slug === "make-webhook-airtable-sync") {
    return {
      accentColor: "#a855f7",
      accentGlow: "rgba(168, 85, 247, 0.4)",
      bgGradient: "linear-gradient(135deg, #160b24 0%, #231238 50%, #0c1117 100%)",
      sourceNode: { icon: "HOOK", label: "Webhook" },
      midNode: { icon: "MAKE", label: "Router" },
      destNode: { icon: "AIRTABLE", label: "Airtable" },
      badgeText: "MULTI-BRANCH"
    };
  }

  if (slug === "zapier-migration") {
    return {
      accentColor: "#f59e0b",
      accentGlow: "rgba(245, 158, 11, 0.4)",
      bgGradient: "linear-gradient(135deg, #181308 0%, #261e0b 50%, #0c1117 100%)",
      sourceNode: { icon: "ZAP", label: "Zapier" },
      midNode: { icon: "MIGRATE", label: "Transpile" },
      destNode: { icon: "HOST", label: "Self-Host" },
      badgeText: "COST SAVER"
    };
  }

  // Fallback defaults for new / user contributed blueprints
  return {
    accentColor: "#f97316",
    accentGlow: "rgba(249, 115, 22, 0.4)",
    bgGradient: "linear-gradient(135deg, #11141e 0%, #191e2c 50%, #0d0f17 100%)",
    sourceNode: { icon: "IN", label: tools[0] || "Trigger" },
    midNode: { icon: "PROC", label: tools[1] || "Process" },
    destNode: { icon: "OUT", label: tools[2] || "Target" },
    badgeText: "BLUEPRINT"
  };
}

const theme = getTheme(slug, category, tools);
---

<div class="workflow-thumbnail" style={`--thumb-accent: ${theme.accentColor}; --thumb-glow: ${theme.accentGlow}; --thumb-bg: ${theme.bgGradient};`}>
  <!-- Background Grid & Glow Aura -->
  <div class="thumb-grid-pattern"></div>
  <div class="thumb-glow-aura"></div>

  <!-- Micro Header Badge -->
  <div class="thumb-meta-bar">
    <div class="thumb-badge">
      <span class="pulse-dot"></span>
      <span>{theme.badgeText}</span>
    </div>
    <div class="thumb-latency">
      <span>TOPOLOGY</span>
    </div>
  </div>

  <!-- Schematic Architecture Diagram -->
  <div class="thumb-schematic">
    <!-- Node 1: Input -->
    <div class="schematic-node node-source">
      <div class="node-icon-box">
        {theme.sourceNode.icon === "DOCKER" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path><path d="M8 19h8"></path><path d="M12 16v6"></path></svg>
        )}
        {theme.sourceNode.icon === "STRIPE" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>
        )}
        {theme.sourceNode.icon === "AUDIO" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" x2="12" y1="19" y2="22"></line></svg>
        )}
        {theme.sourceNode.icon === "EDGE" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" x2="22" y1="12" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        )}
        {theme.sourceNode.icon === "DOC" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        )}
        {theme.sourceNode.icon === "GIT" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 9v12"></path><path d="M18 9a9 9 0 0 0-9 9"></path></svg>
        )}
        {theme.sourceNode.icon === "HOOK" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        )}
        {theme.sourceNode.icon === "ZAP" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        )}
        {theme.sourceNode.icon === "IN" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg>
        )}
      </div>
      <span class="node-label">{theme.sourceNode.label}</span>
    </div>

    <!-- Animated Data Connector 1 -->
    <div class="schematic-pipe">
      <div class="pipe-line"></div>
      <div class="pipe-pulse"></div>
      <div class="pipe-arrow">&#x2192;</div>
    </div>

    <!-- Node 2: Core Processing / Engine -->
    <div class="schematic-node node-mid">
      <div class="node-icon-box mid-box">
        {theme.midNode.icon === "CADDY" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        )}
        {theme.midNode.icon === "HMAC" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        )}
        {theme.midNode.icon === "CLAUDE" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
        )}
        {theme.midNode.icon === "WORKER" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        )}
        {theme.midNode.icon === "OCR" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        )}
        {theme.midNode.icon === "RUNNER" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        )}
        {theme.midNode.icon === "MAKE" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
        )}
        {theme.midNode.icon === "MIGRATE" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
        )}
        {theme.midNode.icon === "PROC" && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        )}
      </div>
      <span class="node-label highlight">{theme.midNode.label}</span>
    </div>

    <!-- Animated Data Connector 2 -->
    <div class="schematic-pipe">
      <div class="pipe-line"></div>
      <div class="pipe-pulse delay"></div>
      <div class="pipe-arrow">&#x2192;</div>
    </div>

    <!-- Node 3: Target Storage / Result -->
    <div class="schematic-node node-dest">
      <div class="node-icon-box">
        {theme.destNode.icon === "N8N" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="12" r="3"></circle><line x1="8.6" x2="15.4" y1="7.3" y2="10.7"></line><line x1="8.6" x2="15.4" y1="16.7" y2="13.3"></line></svg>
        )}
        {theme.destNode.icon === "PGSQL" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
        )}
        {theme.destNode.icon === "NOTION" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
        )}
        {theme.destNode.icon === "KV" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        )}
        {theme.destNode.icon === "SHEETS" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><line x1="3" x2="21" y1="9" y2="9"></line><line x1="3" x2="21" y1="15" y2="15"></line><line x1="9" x2="9" y1="3" y2="21"></line><line x1="15" x2="15" y1="3" y2="21"></line></svg>
        )}
        {theme.destNode.icon === "VPS" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>
        )}
        {theme.destNode.icon === "AIRTABLE" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
        )}
        {theme.destNode.icon === "HOST" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        )}
        {theme.destNode.icon === "OUT" && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        )}
      </div>
      <span class="node-label">{theme.destNode.label}</span>
    </div>
  </div>

  <!-- Bottom Terminal Micro-Log -->
  <div class="thumb-footer">
    <div class="thumb-code-snippet">
      <span class="code-prompt">$</span>
      <span class="code-text">{tools.slice(0, 2).join(" | ")}</span>
    </div>
    <span class="thumb-status-dot"></span>
  </div>
</div>

<style>
  .workflow-thumbnail {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    background: var(--thumb-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    box-sizing: border-box;
    border-bottom: 1px solid var(--border);
    user-select: none;
  }

  .thumb-grid-pattern {
    position: absolute;
    inset: 0;
    background-size: 16px 16px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    pointer-events: none;
    z-index: 1;
  }

  .thumb-glow-aura {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 100px;
    background: radial-gradient(circle, var(--thumb-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
    opacity: 0.65;
    filter: blur(20px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  :global(.workflow-card:hover) .thumb-glow-aura {
    opacity: 0.95;
    transform: translate(-50%, -50%) scale(1.15);
  }

  .thumb-meta-bar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .thumb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.45rem;
    background: rgba(9, 10, 15, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    color: var(--thumb-accent);
    letter-spacing: 0.06em;
    backdrop-filter: blur(4px);
  }

  .pulse-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--thumb-accent);
    box-shadow: 0 0 6px var(--thumb-accent);
  }

  .thumb-latency {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--text-subtle);
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  /* Schematic Layout */
  .thumb-schematic {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0.25rem 0;
  }

  .schematic-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    flex: 0 0 auto;
  }

  .node-icon-box {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-xs);
    background: rgba(18, 21, 29, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  :global(.workflow-card:hover) .node-icon-box {
    border-color: rgba(255, 255, 255, 0.25);
  }

  .node-icon-box.mid-box {
    width: 38px;
    height: 38px;
    background: rgba(26, 30, 42, 0.95);
    border-color: var(--thumb-accent);
    color: var(--thumb-accent);
    box-shadow: 0 0 12px var(--thumb-glow);
  }

  :global(.workflow-card:hover) .node-icon-box.mid-box {
    transform: scale(1.08);
  }

  .node-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-subtle);
    font-weight: 600;
    max-width: 65px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .node-label.highlight {
    color: var(--text);
    font-weight: 700;
  }

  /* Connector Pipes */
  .schematic-pipe {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 16px;
  }

  .pipe-line {
    position: absolute;
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
  }

  .pipe-arrow {
    position: relative;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.35);
    z-index: 1;
    line-height: 1;
  }

  /* Micro Footer */
  .thumb-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 0.35rem;
  }

  .thumb-code-snippet {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .code-prompt {
    color: var(--thumb-accent);
    font-weight: 700;
  }

  .code-text {
    color: var(--text-subtle);
    max-width: 170px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .thumb-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }
</style>
