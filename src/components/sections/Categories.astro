---
import { getAllCategories } from "../../lib/categories.js";
import { getAllWorkflows } from "../../lib/workflows.js";

const allCategories = await getAllCategories();
const allWorkflows = await getAllWorkflows();

const categoriesWithCount = allCategories.map((cat) => {
  const count = allWorkflows.filter(
    (w) => w.category?.toLowerCase() === cat.name.toLowerCase() ||
           w.category?.toLowerCase() === cat.slug.toLowerCase()
  ).length;
  return {
    ...cat,
    count,
  };
});
---

<section class="categories-section">
  <div class="container">
    <div class="heading-row">
      <div class="heading">
        <div class="section-tag">
          <span class="tag-dot"></span>
          <span>TAXONOMY &amp; RUNTIMES</span>
        </div>
        <h2>Engineered by Stack</h2>
        <p class="subtitle">Filter blueprints across orchestration engines, edge runtimes, and webhook integrations.</p>
      </div>

      <a href="/categories" class="view-all-btn">
        <span>All 8 categories</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <div class="grid categories-grid">
      {categoriesWithCount.slice(0, 4).map((c) => (
        <a href={`/categories/${c.slug}`} class="card category-card">
          <div class="cat-top">
            <span class="cat-badge">{c.count} {c.count === 1 ? 'guide' : 'guides'}</span>
            <div class="cat-arrow-box">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </div>
          <h3>{c.name}</h3>
          <p>{c.description || `Production blueprints and automation patterns for ${c.name}.`}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categories-section {
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .heading-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .heading {
    max-width: 600px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .heading h2 {
    font-size: var(--fs-2xl);
    line-height: 1.15;
  }

  .subtitle {
    margin-top: 0.5rem;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .view-all-btn:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    color: var(--text);
    transform: translateX(2px);
  }

  .categories-grid {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: var(--transition);
    height: 100%;
  }

  .category-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .cat-badge {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  .cat-arrow-box {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-subtle);
    transition: var(--transition);
  }

  .category-card:hover .cat-arrow-box {
    color: var(--text);
    border-color: var(--border-strong);
    transform: translateX(2px);
  }

  .category-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .category-card p {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 768px) {
    .categories-section {
      padding: 2.5rem 0;
    }

    .heading-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .categories-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

