---
import { getAllWorkflows } from "../../lib/workflows.js";
import WorkflowCard from "../content/WorkflowCard.astro";

const allWorkflows = await getAllWorkflows();
const featuredWorkflows = allWorkflows.slice(0, 3);
const totalCount = allWorkflows.length;
---

<section class="featured">
  <div class="container">
    <div class="heading-row">
      <div class="heading">
        <div class="section-tag">
          <span class="tag-dot"></span>
          <span>CURATED ARCHITECTURES</span>
        </div>
        <h2>Featured Workflows</h2>
        <p class="subtitle">Self-contained production automation guides with source files, schemas, and live setup.</p>
      </div>

      <a href="/workflows" class="view-all-btn">
        <span>Browse all {totalCount} blueprints</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <div class="grid workflows-grid">
      {featuredWorkflows.map((w) => (
        <div class="workflow-card-wrapper">
          <WorkflowCard
            slug={w.slug}
            title={w.title}
            description={w.description}
            category={w.category}
            difficulty={w.difficulty}
            readingTime={w.readingTime}
            tools={w.tools || []}
            cover={w.cover}
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .featured {
    padding: 3.5rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .heading-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .heading {
    max-width: 600px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .heading h2 {
    font-size: var(--fs-2xl);
    line-height: 1.15;
  }

  .subtitle {
    margin-top: 0.5rem;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .view-all-btn:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    color: var(--text);
    transform: translateX(2px);
  }

  .workflows-grid {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .workflow-card-wrapper {
    height: 100%;
  }

  @media (max-width: 768px) {
    .featured {
      padding: 2.5rem 0;
    }

    .heading-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .workflows-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

