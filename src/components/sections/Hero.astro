---
import { getAllWorkflows } from "../../lib/workflows.js";

const allWorkflows = await getAllWorkflows();
const workflowCount = allWorkflows.length;

const popularStacks = [
  { name: "n8n", href: "/categories/n8n", icon: "node" },
  { name: "Claude & AI", href: "/categories/ai-agents", icon: "sparkles" },
  { name: "Workers KV", href: "/categories/cloudflare-workers", icon: "globe" },
  { name: "GitHub CI", href: "/categories/github-actions", icon: "terminal" },
  { name: "Make", href: "/categories/make", icon: "workflow" },
];
---

<section class="hero">
  <div class="container">
    <div class="hero-left">
      <div class="badge-pill">
        <span class="badge-pulse"></span>
        <span class="badge-text">AUTOMATION VAULT</span>
        <span class="badge-divider">•</span>
        <span class="badge-sub">{workflowCount} BLUEPRINTS &amp; TEMPLATES</span>
      </div>

      <h1>
        Practical, production-ready
        <span class="hero-gradient-text">automation blueprints</span> for builders.
      </h1>

      <p class="description">
        For freelancers, developers, hobbyists, and creators. Self-hostable pipelines, AI agents, and webhook syncs—ready to run on your local machine or a $4/mo cloud server.
      </p>

      <form action="/search" method="GET" class="hero-search-form">
        <div class="search-input-wrapper">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search triggers, stacks, tools (e.g. n8n, Claude, Docker)..."
            aria-label="Search workflows"
          />
          <div class="search-trailing">
            <kbd class="kbd-chip">↵ Enter</kbd>
            <button type="submit" class="search-submit">Browse</button>
          </div>
        </div>
      </form>

      <div class="quick-stacks">
        <span class="stacks-label">Stacks:</span>
        <div class="stacks-list">
          {popularStacks.map((stack) => (
            <a href={stack.href} class="stack-tag">
              <span class="stack-dot"></span>
              {stack.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-right">
      <!-- High-craft interactive Developer Blueprint Inspector -->
      <div class="blueprint-terminal">
        <div class="terminal-bar">
          <div class="terminal-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <div class="terminal-tab">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span>pipeline.production.ts</span>
          </div>
          <div class="terminal-status">
            <span class="status-indicator"></span>
            <span>200 OK</span>
          </div>
        </div>

        <div class="pipeline-visual">
          <div class="node-track">
            <!-- Node 1: Webhook Ingest -->
            <div class="pipeline-node active">
              <div class="node-icon-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
              </div>
              <div class="node-meta">
                <span class="node-label">01 TRIGGER</span>
                <span class="node-title">POST /webhook/stripe</span>
              </div>
              <span class="node-tag ok">Verified</span>
            </div>

            <div class="node-connector">
              <div class="connector-line"></div>
              <span class="connector-payload">signed HMAC</span>
            </div>

            <!-- Node 2: Claude AI Synthesis -->
            <div class="pipeline-node featured">
              <div class="node-icon-box accent">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
                </svg>
              </div>
              <div class="node-meta">
                <span class="node-label">02 AI AGENT</span>
                <span class="node-title">Claude 3.5 Sonnet (Schema Extraction)</span>
              </div>
              <span class="node-tag latency">340ms</span>
            </div>

            <div class="node-connector">
              <div class="connector-line"></div>
              <span class="connector-payload">Zod Validated</span>
            </div>

            <!-- Node 3: Storage & Edge Distribution -->
            <div class="pipeline-node">
              <div class="node-icon-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
              </div>
              <div class="node-meta">
                <span class="node-label">03 STORAGE</span>
                <span class="node-title">PostgreSQL &amp; Cloudflare KV</span>
              </div>
              <span class="node-tag synced">Atomic</span>
            </div>
          </div>

          <div class="blueprint-footer">
            <div class="stat-group">
              <span class="stat-num">100%</span>
              <span class="stat-lbl">Open Source</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-group">
              <span class="stat-num">0 ms</span>
              <span class="stat-lbl">Cold Start</span>
            </div>
            <div class="stat-divider"></div>
            <a href="/workflows" class="explore-btn">
              <span>Browse 8 Blueprints</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 3.5rem 0 3rem;
    position: relative;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 4.5rem 0 4rem;
    }
  }

  .container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    box-shadow: var(--specular);
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .badge-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .badge-text {
    color: var(--text);
    letter-spacing: 0.05em;
  }

  .badge-divider {
    color: var(--text-subtle);
  }

  .badge-sub {
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  h1 {
    font-size: var(--fs-display);
    line-height: 1.08;
    margin: 0 0 1.25rem;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .hero-gradient-text {
    background: linear-gradient(135deg, #ffffff 0%, var(--accent-hover) 60%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .description {
    color: var(--text-muted);
    font-size: clamp(0.95rem, 2vw, 1.0625rem);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 1.5rem;
  }

  .hero-search-form {
    max-width: 520px;
    margin-bottom: 1.25rem;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    padding: 0.35rem 0.4rem 0.35rem 0.9rem;
    transition: var(--transition);
  }

  .search-input-wrapper:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft), var(--specular);
  }

  .search-icon {
    color: var(--text-subtle);
    flex-shrink: 0;
    margin-right: 0.6rem;
  }

  .search-input-wrapper input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-size: var(--fs-sm);
    font-family: inherit;
  }

  .search-input-wrapper input::placeholder {
    color: var(--text-subtle);
  }

  .search-trailing {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .kbd-chip {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-subtle);
  }

  .search-submit {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-xs);
    background: var(--surface-hover);
    color: var(--text);
    font-size: var(--fs-xs);
    font-weight: 600;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: var(--transition);
  }

  .search-submit:hover {
    background: var(--surface-active);
    border-color: var(--border-strong);
  }

  .quick-stacks {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stacks-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-subtle);
    font-family: var(--font-mono);
  }

  .stacks-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .stack-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-2xs);
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: var(--transition);
    text-decoration: none;
  }

  .stack-tag:hover {
    border-color: var(--accent);
    color: var(--text);
    background: var(--surface-hover);
  }

  .stack-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Blueprint Terminal */
  .blueprint-terminal {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.9rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .terminal-tab {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--text-muted);
    font-weight: 500;
  }

  .terminal-status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #10b981;
    font-weight: 600;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .pipeline-visual {
    padding: 1.25rem;
  }

  .node-track {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pipeline-node {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--specular);
    transition: var(--transition);
  }

  .pipeline-node:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .pipeline-node.featured {
    border-color: var(--accent-border);
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.06) 0%, var(--surface-2) 100%);
  }

  .node-icon-box {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .node-icon-box.accent {
    background: var(--accent-soft);
    border-color: var(--accent-border);
    color: var(--accent);
  }

  .node-meta {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
  }

  .node-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
  }

  .node-title {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .node-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .node-tag.ok {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .node-tag.latency {
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .node-tag.synced {
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .node-connector {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1.25rem;
    position: relative;
  }

  .connector-line {
    width: 2px;
    height: 14px;
    background: var(--border-strong);
    margin-left: 5px;
  }

  .connector-payload {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-subtle);
    font-weight: 500;
  }

  .blueprint-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border-subtle);
  }

  .stat-group {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: var(--fs-xs);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text);
  }

  .stat-lbl {
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }

  .stat-divider {
    width: 1px;
    height: 22px;
    background: var(--border);
  }

  .explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-xs);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    transition: var(--transition);
  }

  .explore-btn:hover {
    background: rgba(249, 115, 22, 0.2);
    transform: translateX(2px);
  }
</style>

