---
// Stage data for the pipeline visual. "current" marks the stage shown as
// live/active (accent glow + pulse), representing the ongoing "Automate"
// phase of a running workflow.
const stages = [
  { name: "Research", description: "Scope the problem and the tools it needs." },
  { name: "Build", description: "Assemble the workflow, step by step." },
  { name: "Connect", description: "Wire up integrations and credentials." },
  { name: "Automate", description: "Run it on a schedule or a trigger.", current: true },
  { name: "Verify", description: "Confirm the result holds up in production." },
];
---

<section class="hero">
  <div class="container">

    <div class="content">
      <p class="eyebrow">AI AUTOMATION PLATFORM</p>

      <h1>
        Build Powerful
        <span>AI Workflows</span>
      </h1>

      <p class="description">
        Practical, production-focused automation guides and implementation tutorials
        for developers, freelancers and businesses.
      </p>

      <div class="actions">
        <a href="/workflows" class="button">Explore Workflows</a>
        <a href="/categories" class="secondary">Browse Categories</a>
      </div>
    </div>

    <div class="pipeline">
      <p class="pipeline-label">How a workflow moves through the vault</p>

      <div class="pipeline-track">
        {stages.map((stage, i) => (
          <div class:list={["stage", stage.current && "is-current"]}>
            <div class="stage-marker">
              <span>{String(i + 1).padStart(2, "0")}</span>
              {stage.current && <span class="pulse" aria-hidden="true"></span>}
            </div>
            <div class="stage-body">
              <p class="stage-name">{stage.name}</p>
              <p class="stage-desc">{stage.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
.hero{
  padding:6rem 0;
}

.container{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:3rem;
  align-items:center;
}

.eyebrow{
  color:var(--accent);
  font-weight:700;
  letter-spacing:.15em;
  margin-bottom:1rem;
}

h1{
  font-size:clamp(3rem,7vw,5rem);
  line-height:1;
  margin:0 0 1.5rem;
}

h1 span{
  color:var(--accent);
}

.description{
  color:var(--text-muted);
  font-size:1.1rem;
  line-height:1.8;
  max-width:600px;
}

.actions{
  display:flex;
  gap:1rem;
  margin-top:2rem;
  flex-wrap:wrap;
}

.secondary{
  padding:.9rem 1.5rem;
  border:1px solid var(--border);
  border-radius:999px;
  text-decoration:none;
}

.pipeline{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  padding:var(--space-4);
}

.pipeline-label{
  font-size:var(--fs-xs);
  font-weight:700;
  color:var(--text-muted);
  text-transform:uppercase;
  letter-spacing:.08em;
  margin-bottom:var(--space-3);
}

.pipeline-track{
  position:relative;
}

.pipeline-track::before{
  content:"";
  position:absolute;
  left:19px;
  top:24px;
  bottom:24px;
  width:1px;
  background:var(--border);
}

.stage{
  position:relative;
  display:flex;
  gap:var(--space-3);
  padding:var(--space-2) 0;
}

.stage-marker{
  position:relative;
  flex-shrink:0;
  width:40px;
  height:40px;
  border-radius:999px;
  background:var(--surface-2);
  border:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:1;
  transition:var(--transition);
}

.stage-marker span:first-child{
  font-family:monospace;
  font-weight:700;
  font-size:var(--fs-xs);
  color:var(--text-muted);
  transition:var(--transition);
}

.stage-body{
  padding-top:.2rem;
}

.stage-name{
  font-size:1rem;
  font-weight:700;
  margin-bottom:.2rem;
  transition:var(--transition);
}

.stage-desc{
  font-size:var(--fs-xs);
  color:var(--text-muted);
  margin:0;
}

.stage.is-current .stage-marker{
  background:var(--accent-soft);
  border-color:var(--accent);
}

.stage.is-current .stage-marker span:first-child{
  color:var(--accent);
}

.stage.is-current .stage-name{
  color:var(--accent);
}

.pulse{
  position:absolute;
  top:-2px;
  right:-2px;
  width:10px;
  height:10px;
  border-radius:50%;
  background:var(--accent);
  animation:pulse 2s ease-out infinite;
}

@keyframes pulse{
  0%{ box-shadow:0 0 0 0 rgba(255,107,0,.5); }
  70%{ box-shadow:0 0 0 10px rgba(255,107,0,0); }
  100%{ box-shadow:0 0 0 0 rgba(255,107,0,0); }
}

@media (max-width:900px){

.container{
  grid-template-columns:1fr;
}

.hero{
  padding:4rem 0;
}

}
</style>
