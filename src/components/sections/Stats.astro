---
import { getAllWorkflows } from "../../lib/workflows.js";

const workflows = await getAllWorkflows();
const uniqueTools = new Set(workflows.flatMap((w) => w.tools || []));
const guideCount = workflows.length;
const toolCount = uniqueTools.size;

const stats = [
  { value: `${guideCount}`, label: "Production Blueprints", sub: "100% runnable code", metric: "BLUEPRINTS" },
  { value: `${toolCount}+`, label: "Integrated Runtimes", sub: "n8n, Workers, Make, APIs", metric: "ECOSYSTEM" },
  { value: "100%", label: "Open Architectures", sub: "Self-hostable Docker & configs", metric: "PERMISSIVE" },
  { value: "0 ms", label: "Zero Framework Lock-in", sub: "Native web standards", metric: "RUNTIME" },
];
---

<section class="stats">
  <div class="container">
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="stat-card">
          <div class="stat-top">
            <span class="stat-metric-tag">{s.metric}</span>
            <span class="stat-dot"></span>
          </div>
          <div class="stat-val">{s.value}</div>
          <div class="stat-label">{s.label}</div>
          <div class="stat-sub">{s.sub}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats {
    padding: 2.5rem 0 3.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.25rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .stat-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    transform: translateY(-2px);
  }

  .stat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .stat-metric-tag {
    font-size: 0.625rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--text-subtle);
    letter-spacing: 0.08em;
  }

  .stat-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .stat-val {
    font-size: 2.25rem;
    font-family: var(--font-mono);
    font-weight: 800;
    line-height: 1;
    color: var(--text);
    letter-spacing: -0.04em;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .stat-sub {
    font-size: var(--fs-2xs);
    color: var(--text-muted);
    line-height: 1.4;
  }

  @media (max-width: 960px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
