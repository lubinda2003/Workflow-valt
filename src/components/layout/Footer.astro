---
const year = new Date().getFullYear();

const columns = [
  {
    heading: "Blueprints",
    links: [
      { label: "All Workflows", href: "/workflows" },
      { label: "Stacks & Categories", href: "/categories" },
      { label: "Instant Search", href: "/search" },
    ],
  },
  {
    heading: "Builders",
    links: [
      { label: "Stack Configurator", href: "/builder" },
      { label: "Code & Resources", href: "/resources" },
      { label: "Autonomous Pipeline", href: "/pipeline" },
      { label: "Contribute Blueprint", href: "/contribute" },
      { label: "Mission & Standards", href: "/about" },
      { label: "GitHub Repository", href: "https://github.com/lubinda2003/Workflow-valt" },
    ],
  },
  {
    heading: "Ecosystem",
    links: [
      { label: "n8n Automation", href: "/categories/n8n" },
      { label: "AI Agents", href: "/categories/ai-agents" },
      { label: "Cloudflare Workers", href: "/categories/cloudflare-workers" },
      { label: "GitHub Actions CI", href: "/categories/github-actions" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="brand">
        <a href="/" class="logo">
          <div class="logo-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <span class="logo-text">Workflow<span class="logo-accent">Vault</span></span>
        </a>
        <p class="tagline">Production-grade automation blueprints for freelancers, developers, hobbyists, and creators.</p>
        <div class="system-status">
          <span class="status-pulse"></span>
          <span>SYSTEMS OPERATIONAL • ALL BLUEPRINTS VERIFIED</span>
        </div>
      </div>

      <div class="columns">
        {columns.map((col) => (
          <div class="column">
            <p class="col-heading">{col.heading}</p>
            <ul>
              {col.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom">
      <p>&copy; {year} Workflow Vault. Open-source under MIT License.</p>
      <div class="footer-meta-tags">
        <span class="meta-tag">ASTRO 5.x</span>
        <span class="meta-tag">SSG 100%</span>
        <span class="meta-tag">ZERO TRACKING</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4.5rem 0 2.5rem;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.25fr 2fr;
    gap: 3.5rem;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 0.85rem;
  }

  .logo-mark {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-xs);
    background: linear-gradient(135deg, #1e2330 0%, #12151d 100%);
    border: 1px solid var(--border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    box-shadow: var(--specular);
  }

  .logo-accent {
    color: var(--accent);
  }

  .tagline {
    max-width: 340px;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .system-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-subtle);
    padding: 0.25rem 0.55rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    letter-spacing: 0.05em;
  }

  .status-pulse {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .col-heading {
    color: var(--text);
    font-weight: 700;
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .column ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .column a {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition: var(--transition);
  }

  .column a:hover {
    color: var(--text);
    transform: translateX(2px);
    display: inline-block;
  }

  .footer-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 3.5rem 0 1.5rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: var(--fs-2xs);
    color: var(--text-subtle);
  }

  .footer-meta-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text-subtle);
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .columns {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
