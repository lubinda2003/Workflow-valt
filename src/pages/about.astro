---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { getAllWorkflows } from "../lib/workflows.js";
import { getAllCategories } from "../lib/categories.js";

const workflows = await getAllWorkflows();
const categories = await getAllCategories();

const aboutSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://workflowvault.dev"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About",
        "item": "https://workflowvault.dev/about"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Workflow Vault",
    "description": "Workflow Vault is an open library of practical, production-focused AI and automation workflow blueprints for freelancers, developers, hobbyists, and creators.",
    "publisher": {
      "@type": "Organization",
      "name": "Workflow Vault",
      "url": "https://workflowvault.dev",
      "logo": "https://workflowvault.dev/favicon.svg"
    }
  }
];

const personas = [
  {
    title: "Freelancers & Agencies",
    badge: "CLIENT ROI",
    desc: "Build resilient automation pipelines for clients without high monthly SaaS overhead. Deploy self-hosted n8n or Make webhooks with 99.9% uptime on inexpensive cloud servers.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`
  },
  {
    title: "Software Developers",
    badge: "CODE-FIRST",
    desc: "Get straight to the point with exact TypeScript edge workers, Docker Compose stacks, GitHub Actions CI/CD workflows, and cryptographic HMAC signature validation.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`
  },
  {
    title: "Hobbyists & Self-Hosters",
    badge: "100% FREE DEV",
    desc: "Run automations locally on your everyday PC, Mac, Raspberry Pi, or home server. Keep full ownership of your data, credentials, and execution schedules.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`
  },
  {
    title: "Automation Enthusiasts",
    badge: "NO GATEKEEPING",
    desc: "Graduate from simple no-code zaps into intelligent AI agent workflows, vector embeddings, and multi-service event routers with clear, jargon-free explanations.",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`
  }
];

const hostingOptions = [
  {
    title: "Cloud VPS (DigitalOcean / Hetzner)",
    cost: "~$4 to $6 / mo",
    bestFor: "24/7 webhooks, clients, production",
    desc: "Don't have hardware at home that stays on 24/7? A low-cost virtual private server gives you a dedicated Linux machine with a permanent public IP and automated SSL for all your incoming webhooks."
  },
  {
    title: "Local Hardware (Docker / Desktop)",
    cost: "$0 / mo (Free)",
    bestFor: "Testing, hobbyists, home labs",
    desc: "Spin up any stack on your personal laptop, Mac Mini, or Raspberry Pi in minutes. Perfect for experimenting and local workflow building before taking things to the cloud."
  },
  {
    title: "Serverless & 1-Click Cloud",
    cost: "Generous Free Tiers",
    bestFor: "Edge APIs, zero OS maintenance",
    desc: "Deploy directly to Cloudflare Workers (100k requests/day free), GitHub Actions, or managed platforms like n8n Cloud and Make for instant setup with zero server management."
  }
];
---

<BaseLayout
  title="About Workflow Vault — Open Automation Blueprints"
  description="Workflow Vault is an open library of practical, production-focused AI and automation workflow blueprints for freelancers, developers, hobbyists, and creators."
  schema={aboutSchema}
>

<Header />

<main class="about-page">
  <section class="about-hero">
    <div class="container">
      <div class="section-tag">
        <span class="tag-dot"></span>
        <span>MISSION &amp; VALUES</span>
      </div>
      <h1>Practical automation for everyone who builds.</h1>
      <p class="subtitle">
        Whether you are a freelancer delivering client systems, a developer building edge pipelines, a hobbyist with a home lab, or a curious creator—Workflow Vault gives you real, runnable code and transparent architecture.
      </p>
    </div>
  </section>

  <!-- Audience Section -->
  <section class="about-section">
    <div class="container">
      <div class="section-heading">
        <h2>Who Workflow Vault is built for</h2>
        <p class="heading-sub">No gatekeeping, no superficial demos. Clear patterns for every builder.</p>
      </div>

      <div class="grid audience-grid">
        {personas.map((p) => (
          <div class="card persona-card">
            <div class="persona-top">
              <div class="persona-icon" set:html={p.icon} />
              <span class="persona-badge">{p.badge}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hardware & Hosting Section -->
  <section class="about-section hosting-philosophy-section">
    <div class="container">
      <div class="section-heading">
        <span class="mini-tag">HARDWARE &amp; RUNTIMES</span>
        <h2>No home hardware? Run in the cloud for $4/mo.</h2>
        <p class="heading-sub">You don't need a dedicated physical server at home to run production-grade automations.</p>
      </div>

      <div class="grid hosting-grid">
        {hostingOptions.map((h) => (
          <div class="card hosting-card">
            <div class="hosting-cost-badge">{h.cost}</div>
            <h3>{h.title}</h3>
            <div class="hosting-best-for"><strong>Best for:</strong> {h.bestFor}</div>
            <p>{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Balanced Tone Standard -->
  <section class="about-section">
    <div class="container">
      <div class="standard-banner">
        <div class="standard-content">
          <div class="section-tag">
            <span class="tag-dot"></span>
            <span>THE BALANCED CRAFT STANDARD</span>
          </div>
          <h2>Clear for beginners. Direct for experienced pros.</h2>
          <p>
            We believe technical guides shouldn't make beginners feel lost with unexplained acronyms, nor should they talk down to developers like children.
          </p>
          <div class="standard-points">
            <div class="point-item">
              <div class="point-check">✓</div>
              <div>
                <strong>Integrated Glossaries &amp; "Why" Context</strong>
                <span>Clear 1-sentence explanations for key concepts so anyone can understand how the pipeline works.</span>
              </div>
            </div>
            <div class="point-item">
              <div class="point-check">✓</div>
              <div>
                <strong>Direct Code &amp; Exact Configuration</strong>
                <span>Zero fluff, zero marketing hype. Pure copyable Docker Compose stacks, TypeScript workers, and JSON configs.</span>
              </div>
            </div>
            <div class="point-item">
              <div class="point-check">✓</div>
              <div>
                <strong>Tested Failure Modes &amp; Fixes</strong>
                <span>Explicit troubleshooting tables covering real-world errors and exact solutions.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Hub -->
  <section class="about-navigation-hub">
    <div class="container">
      <div class="hub-card">
        <div class="hub-text">
          <h2>Explore the blueprint collection</h2>
          <p>Browse our catalog of {workflows.length} production guides across {categories.length} supported automation ecosystems.</p>
        </div>
        <div class="hub-actions">
          <a href="/workflows" class="button">Browse All Workflows</a>
          <a href="/resources" class="secondary">Code &amp; Docker Stacks</a>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer />

</BaseLayout>

<style>
  .about-hero {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(249, 115, 22, 0.06) 0%, transparent 60%);
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .about-hero h1 {
    font-size: var(--fs-2xl);
    line-height: 1.15;
    max-width: 820px;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .subtitle {
    max-width: 720px;
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .about-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-heading {
    max-width: 640px;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    font-size: var(--fs-xl);
    margin-bottom: 0.35rem;
  }

  .heading-sub {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .mini-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .audience-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .persona-card {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .persona-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    transform: translateY(-2px);
  }

  .persona-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .persona-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    box-shadow: var(--specular);
  }

  .persona-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    border-radius: var(--radius-xs);
    letter-spacing: 0.06em;
  }

  .persona-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
  }

  .persona-card p {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .hosting-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .hosting-card {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .hosting-cost-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
    margin-bottom: 0.75rem;
  }

  .hosting-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .hosting-best-for {
    font-size: var(--fs-2xs);
    color: var(--text-subtle);
    margin-bottom: 0.75rem;
  }

  .hosting-card p {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .standard-banner {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
  }

  .standard-content h2 {
    font-size: var(--fs-xl);
    margin-bottom: 0.5rem;
  }

  .standard-content p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 680px;
  }

  .standard-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .point-item {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }

  .point-check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .point-item strong {
    display: block;
    font-size: var(--fs-xs);
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .point-item span {
    display: block;
    font-size: var(--fs-2xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .about-navigation-hub {
    padding: 3.5rem 0 4.5rem;
  }

  .hub-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  .hub-text h2 {
    font-size: var(--fs-lg);
    margin-bottom: 0.35rem;
  }

  .hub-text p {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .hub-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .secondary:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
    color: var(--text);
  }

  @media (max-width: 860px) {
    .audience-grid, .hosting-grid, .standard-points {
      grid-template-columns: 1fr;
    }

    .hub-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
