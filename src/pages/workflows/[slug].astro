---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Badge from "../../components/content/Badge.astro";
import ToolTag from "../../components/content/ToolTag.astro";

export async function getStaticPaths() {
  const entries = await getCollection("workflows");

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { workflow: entry.data },
  }));
}

const { workflow } = Astro.props;
---

<BaseLayout
  title={`${workflow.title} — Workflow Vault`}
  description={workflow.description}
>

<Header />

<main>
  <section class="workflow-detail">
    <div class="container">
      <a href="/workflows" class="back">&larr; All workflows</a>

      <div class="detail-top">
        <span class="category">{workflow.category}</span>
        <div class="badges">
          <Badge label={workflow.difficulty} tone="accent" />
          <Badge label={`${workflow.readingTime} read`} tone="muted" />
        </div>
      </div>

      <h1>{workflow.title}</h1>
      <p class="description">{workflow.description}</p>

      <div class="tools">
        {workflow.tools.map((tool) => <ToolTag label={tool} />)}
      </div>

      <div class="tags">
        {workflow.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    </div>
  </section>
</main>

<Footer />

</BaseLayout>

<style>
  .back {
    display: inline-block;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-4);
    transition: var(--transition);
  }

  .back:hover {
    color: var(--text);
  }

  .detail-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .category {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .badges {
    display: flex;
    gap: .5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    max-width: 800px;
    margin-bottom: var(--space-3);
  }

  .description {
    max-width: 640px;
    font-size: var(--fs-md);
    margin-bottom: var(--space-4);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: var(--space-3);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .tag {
    font-size: var(--fs-xs);
    color: var(--accent);
  }
</style>
