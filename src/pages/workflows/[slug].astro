---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import WorkflowHeader from "../../components/content/WorkflowHeader.astro";
import StepSection from "../../components/content/StepSection.astro";
import RelatedWorkflows from "../../components/content/RelatedWorkflows.astro";
import TableOfContents from "../../components/content/TableOfContents.astro";
import ArchitectureDiagram from "../../components/content/ArchitectureDiagram.astro";
import Glossary from "../../components/content/Glossary.astro";
import HostingOptions from "../../components/content/HostingOptions.astro";
import { getWorkflowsByCategorySlug } from "../../lib/workflows.js";
import { slugify } from "../../lib/slugify.js";

export async function getStaticPaths() {
  const entries = await getCollection("workflows");

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { workflow: entry.data },
  }));
}

const { workflow } = Astro.props;

const related = (await getWorkflowsByCategorySlug(slugify(workflow.category)))
  .filter((w) => w.slug !== workflow.slug)
  .slice(0, 3);

const tocItems = [
  { id: "overview", label: "Overview" },
  ...(workflow.glossary.length > 0
    ? [{ id: "glossary", label: "Glossary" }]
    : []),
  { id: "prerequisites", label: "Prerequisites" },
  { id: "hosting", label: "Where to Run This" },
  { id: "steps", label: "Step-by-Step" },
  { id: "architecture", label: "Architecture" },
  { id: "result", label: "Final Result" },
  ...(workflow.troubleshooting.length > 0
    ? [{ id: "troubleshooting", label: "Troubleshooting" }]
    : []),
];

// JSON-LD Schemas
const guideSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://workflowvault.dev"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Workflows",
        "item": "https://workflowvault.dev/workflows"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": workflow.category,
        "item": `https://workflowvault.dev/categories/${slugify(workflow.category)}`
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": workflow.title,
        "item": `https://workflowvault.dev/workflows/${workflow.slug}`
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": workflow.title,
    "description": workflow.description,
    "totalTime": `PT${parseInt(workflow.readingTime, 10) || 15}M`,
    "tool": (workflow.tools || []).map((t: string) => ({
      "@type": "HowToTool",
      "name": t
    })),
    "step": (workflow.steps || []).map((s: any, idx: number) => ({
      "@type": "HowToStep",
      "position": idx + 1,
      "name": s.title,
      "text": s.content
    }))
  }
];
---

<BaseLayout
  title={`${workflow.title} — Workflow Vault`}
  description={workflow.description}
  type="article"
  article={{
    tags: workflow.tools,
    author: "Workflow Vault Engineering"
  }}
  schema={guideSchema}
>

<!-- Subtle Desktop Top Scroll Progress Bar -->
<div class="reading-progress-track" aria-hidden="true">
  <div class="reading-progress-bar" id="reading-progress-bar"></div>
</div>

<Header />

<main class="guide-main">
  <WorkflowHeader
    title={workflow.title}
    description={workflow.description}
    category={workflow.category}
    difficulty={workflow.difficulty}
    readingTime={workflow.readingTime}
    tools={workflow.tools}
    whatYoullBuild={workflow.whatYoullBuild}
  />

  <section class="guide">
    <div class="container guide-layout">
      <!-- Main Content Article (Expands fluidly on Desktop) -->
      <article class="guide-content">
        <div class="toc-mobile-slot">
          <TableOfContents items={tocItems} stepCount={workflow.steps.length} />
        </div>

        <div class="guide-section" id="overview">
          <div class="section-tag-mini">
            <span class="tag-dot"></span>
            <span>BLUEPRINT OVERVIEW</span>
          </div>
          <h2>Overview</h2>
          <div class="overview-body">
            <p>{workflow.overview}</p>
          </div>
          {workflow.beforeYouBegin && (
            <div class="before-you-begin">
              <div class="before-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="13"></line>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                <span class="before-label">Before you begin</span>
              </div>
              <p>{workflow.beforeYouBegin}</p>
            </div>
          )}
        </div>

        {workflow.glossary.length > 0 && (
          <div class="guide-section" id="glossary">
            <div class="section-tag-mini">
              <span class="tag-dot"></span>
              <span>TERMINOLOGY</span>
            </div>
            <h2>Glossary</h2>
            <Glossary terms={workflow.glossary} />
          </div>
        )}

        <div class="guide-section" id="prerequisites">
          <div class="section-tag-mini">
            <span class="tag-dot"></span>
            <span>REQUIREMENTS</span>
          </div>
          <h2>Prerequisites</h2>
          <ul class="prereq-list">
            {workflow.prerequisites.map((item) => (
              <li>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="guide-section" id="hosting">
          <div class="section-tag-mini">
            <span class="tag-dot"></span>
            <span>RUNTIME ENVIRONMENT</span>
          </div>
          <h2>Where to Run This Automation</h2>
          <HostingOptions category={workflow.category} tools={workflow.tools} />
        </div>

        <div class="guide-section" id="steps">
          <div class="steps-heading-bar">
            <div>
              <div class="section-tag-mini">
                <span class="tag-dot"></span>
                <span>EXECUTION PLAYBOOK</span>
              </div>
              <h2>Step-by-step implementation</h2>
              <p class="steps-subtitle">Click the numbered phase buttons as you complete each step to track your live progress.</p>
            </div>
            <div class="progress-container" id="workflow-progress-card">
              <div class="progress-info">
                <span class="progress-label">Phase Progress</span>
                <span class="progress-stat" id="progress-stat">0/{workflow.steps.length} completed (0%)</span>
              </div>
              <div class="progress-bar-track">
                <div class="progress-bar-fill" id="progress-bar-fill" style="width: 0%"></div>
              </div>
            </div>
          </div>

          <div class="steps" id="steps-container" data-workflow-slug={workflow.slug}>
            {workflow.steps.map((step, index) => (
              <StepSection
                number={index + 1}
                title={step.title}
                content={step.content}
                why={step.why}
                expectedResult={step.expectedResult}
                code={step.code}
                stepId={`step-${index + 1}`}
              />
            ))}
          </div>
        </div>

        <div class="guide-section" id="architecture">
          <div class="section-tag-mini">
            <span class="tag-dot"></span>
            <span>SYSTEM TOPOLOGY</span>
          </div>
          <h2>Workflow architecture</h2>
          <p class="section-lead-text">{workflow.architecture}</p>
          <ArchitectureDiagram tools={workflow.tools} />
        </div>

        <div class="guide-section" id="result">
          <div class="section-tag-mini">
            <span class="tag-dot"></span>
            <span>VERIFICATION &amp; NEXT PHASES</span>
          </div>
          <h2>Final result</h2>
          <div class="result-card">
            <p>{workflow.result}</p>
          </div>

          {workflow.nextSteps.length > 0 && (
            <div class="next-steps">
              <p class="next-steps-label">Recommended Extensions &amp; Scaling</p>
              <ul class="next-steps-list">
                {workflow.nextSteps.map((step) => <li>{step}</li>)}
              </ul>
            </div>
          )}
        </div>

        {workflow.troubleshooting.length > 0 && (
          <div class="guide-section" id="troubleshooting">
            <div class="section-tag-mini">
              <span class="tag-dot"></span>
              <span>DEBUGGING &amp; EDGE CASES</span>
            </div>
            <h2>Troubleshooting</h2>
            <div class="troubleshooting-list">
              {workflow.troubleshooting.map((item) => (
                <details class="trouble-item">
                  <summary>
                    <span class="trouble-icon">&#x26A0;</span>
                    <span class="trouble-issue">{item.issue}</span>
                  </summary>
                  <div class="trouble-body">
                    <div class="trouble-row">
                      <span class="trouble-badge trouble-cause">Root Cause</span>
                      <p>{item.cause}</p>
                    </div>
                    <div class="trouble-row">
                      <span class="trouble-badge trouble-fix">Solution</span>
                      <p>{item.fix}</p>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </article>

      <!-- Sticky Navigation Sidebar on Desktop -->
      <div class="toc-sidebar-slot">
        <TableOfContents items={tocItems} stepCount={workflow.steps.length} />
      </div>
    </div>
  </section>

  <RelatedWorkflows workflows={related} />
</main>

<Footer />

</BaseLayout>

<script>
  function setupGuidePage() {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById("reading-progress-bar");
    if (progressBar) {
      window.addEventListener("scroll", () => {
        const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight > 0) {
          const progress = (window.scrollY / totalHeight) * 100;
          progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
        }
      }, { passive: true });
    }

    // 2. Step Progress Tracker with LocalStorage & Live Desktop Sidebar Sync
    const stepsContainer = document.getElementById("steps-container");
    const workflowSlug = stepsContainer?.dataset.workflowSlug;
    const progressFill = document.getElementById("progress-bar-fill");
    const progressStat = document.getElementById("progress-stat");
    const sidebarProgressFill = document.getElementById("sidebar-progress-fill");
    const sidebarProgressText = document.getElementById("sidebar-progress-text");

    if (workflowSlug && stepsContainer) {
      const storageKey = `wv_progress_${workflowSlug}`;
      let completedSteps = new Set(JSON.parse(localStorage.getItem(storageKey) || "[]"));

      function updateProgressUI() {
        const stepEls = stepsContainer.querySelectorAll(".step");
        const total = stepEls.length;
        let count = 0;

        stepEls.forEach((el) => {
          const stepId = el.getAttribute("data-step-id");
          if (stepId && completedSteps.has(stepId)) {
            el.classList.add("completed");
            count++;
          } else {
            el.classList.remove("completed");
          }
        });

        const pct = total > 0 ? Math.round((count / total) * 100) : 0;
        
        // In-page progress bar
        if (progressFill) progressFill.style.width = `${pct}%`;
        if (progressStat) progressStat.textContent = `${count}/${total} completed (${pct}%)`;

        // Desktop sticky sidebar progress bar
        if (sidebarProgressFill) sidebarProgressFill.style.width = `${pct}%`;
        if (sidebarProgressText) sidebarProgressText.textContent = `${count}/${total} done (${pct}%)`;

        try {
          localStorage.setItem(storageKey, JSON.stringify(Array.from(completedSteps)));
        } catch (e) {
          // LocalStorage fallback
        }
      }

      stepsContainer.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest(".step-marker");
        if (!btn) return;

        const stepEl = btn.closest(".step");
        if (!stepEl) return;

        const stepId = stepEl.getAttribute("data-step-id");
        if (!stepId) return;

        if (completedSteps.has(stepId)) {
          completedSteps.delete(stepId);
        } else {
          completedSteps.add(stepId);
        }

        updateProgressUI();
      });

      updateProgressUI();
    }

    // 3. Active Table of Contents highlighting with IntersectionObserver
    const tocLinks = document.querySelectorAll(".toc-sidebar nav a, .toc-mobile nav a");
    const observedSections = Array.from(document.querySelectorAll(".guide-section[id]"));

    if ("IntersectionObserver" in window && observedSections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("id");
              tocLinks.forEach((link) => {
                if (link.getAttribute("href") === `#${id}`) {
                  link.classList.add("active");
                } else {
                  link.classList.remove("active");
                }
              });
            }
          });
        },
        { rootMargin: "-15% 0px -65% 0px" }
      );

      observedSections.forEach((sec) => observer.observe(sec));
    }
  }

  setupGuidePage();
  document.addEventListener("astro:page-load", setupGuidePage);
</script>

<style>
  /* Reading Progress Track fixed to top edge */
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 100;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--accent), #fb923c, #10b981);
    transition: width 0.1s ease-out;
  }

  .guide {
    padding: 3rem 0 5rem;
  }

  /* Responsive Desktop Guide Layout */
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1200px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 3rem;
    }
  }

  @media (min-width: 1440px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 3.5rem;
    }
  }

  .guide-content {
    min-width: 0;
    width: 100%;
  }

  .guide-content p {
    max-width: 78ch;
  }

  .toc-mobile-slot :global(.toc-desktop) {
    display: none;
  }

  .section-tag-mini {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.625rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .guide-section {
    margin-bottom: 3.5rem;
    scroll-margin-top: 100px;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .guide-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .guide-section h2 {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-lead-text {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .overview-body p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  .before-you-begin {
    margin-top: 1.25rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid rgba(249, 115, 22, 0.25);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
  }

  .before-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .before-label {
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .before-you-begin p {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }

  /* Responsive Prerequisites Grid */
  .prereq-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
    padding-left: 0;
    margin: 0;
  }

  .prereq-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .prereq-list li::before {
    content: "\2713";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* Step Header & Progress */
  .steps-heading-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .steps-subtitle {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .progress-container {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.65rem 1rem;
    min-width: 220px;
    box-shadow: var(--shadow-sm);
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-2xs);
    font-family: var(--font-mono);
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .progress-label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-subtle);
  }

  .progress-stat {
    color: var(--accent);
  }

  .progress-bar-track {
    width: 100%;
    height: 6px;
    background: var(--surface-2);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #34d399);
    border-radius: 999px;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .steps {
    display: flex;
    flex-direction: column;
  }

  /* Result & Next Steps */
  .result-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .result-card p {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text);
    line-height: 1.65;
  }

  .next-steps {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .next-steps-label {
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .next-steps-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 0;
    margin: 0;
    list-style: none;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .next-steps-list li {
    position: relative;
    padding-left: 1.25rem;
    line-height: 1.55;
  }

  .next-steps-list li::before {
    content: "\2192";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  /* Troubleshooting Responsive Accordion */
  .troubleshooting-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .trouble-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow: hidden;
    transition: var(--transition);
  }

  .trouble-item:hover {
    border-color: var(--border-strong);
  }

  .trouble-item summary {
    cursor: pointer;
    padding: 1rem 1.25rem;
    font-weight: 600;
    font-size: var(--fs-xs);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    user-select: none;
  }

  .trouble-item summary::-webkit-details-marker {
    display: none;
  }

  .trouble-icon {
    color: var(--accent);
    font-size: 0.85rem;
  }

  .trouble-issue {
    flex: 1;
  }

  .trouble-item summary::after {
    content: "+";
    color: var(--text-subtle);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .trouble-item[open] summary::after {
    content: "\2013";
    color: var(--accent);
  }

  .trouble-body {
    padding: 0 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
  }

  .trouble-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .trouble-row {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
  }

  .trouble-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
    white-space: nowrap;
    align-self: flex-start;
  }

  .trouble-cause {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .trouble-fix {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .trouble-row p {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }

  /* Responsive Breakpoint for Sidebar */
