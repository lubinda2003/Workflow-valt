---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import WorkflowHeader from "../../components/content/WorkflowHeader.astro";
import StepSection from "../../components/content/StepSection.astro";
import RelatedWorkflows from "../../components/content/RelatedWorkflows.astro";
import TableOfContents from "../../components/content/TableOfContents.astro";
import ArchitectureDiagram from "../../components/content/ArchitectureDiagram.astro";
import Glossary from "../../components/content/Glossary.astro";
import { getWorkflowsByCategorySlug } from "../../lib/workflows.js";
import { slugify } from "../../lib/slugify.js";

export async function getStaticPaths() {
  const entries = await getCollection("workflows");

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { workflow: entry.data },
  }));
}

const { workflow } = Astro.props;

const related = (await getWorkflowsByCategorySlug(slugify(workflow.category)))
  .filter((w) => w.slug !== workflow.slug)
  .slice(0, 3);

const tocItems = [
  { id: "overview", label: "Overview" },
  ...(workflow.glossary.length > 0
    ? [{ id: "glossary", label: "Glossary" }]
    : []),
  { id: "prerequisites", label: "Prerequisites" },
  { id: "steps", label: "Step-by-Step" },
  { id: "architecture", label: "Architecture" },
  { id: "result", label: "Final Result" },
  ...(workflow.troubleshooting.length > 0
    ? [{ id: "troubleshooting", label: "Troubleshooting" }]
    : []),
];
---

<BaseLayout
  title={`${workflow.title} — Workflow Vault`}
  description={workflow.description}
>

<Header />

<main>
  <WorkflowHeader
    title={workflow.title}
    description={workflow.description}
    category={workflow.category}
    difficulty={workflow.difficulty}
    readingTime={workflow.readingTime}
    tools={workflow.tools}
    whatYoullBuild={workflow.whatYoullBuild}
  />

  <section class="guide">
    <div class="container guide-layout">
      <article>
        <div class="toc-mobile-slot">
          <TableOfContents items={tocItems} />
        </div>

        <div class="guide-section" id="overview">
          <h2>Overview</h2>
          <p>{workflow.overview}</p>
          {workflow.beforeYouBegin && (
            <div class="before-you-begin">
              <span class="before-label">Before you begin</span>
              <p>{workflow.beforeYouBegin}</p>
            </div>
          )}
        </div>

        {workflow.glossary.length > 0 && (
          <div class="guide-section" id="glossary">
            <h2>Glossary</h2>
            <Glossary terms={workflow.glossary} />
          </div>
        )}

        <div class="guide-section" id="prerequisites">
          <h2>Prerequisites</h2>
          <ul class="prereq-list">
            {workflow.prerequisites.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="guide-section" id="steps">
          <h2>Step-by-step implementation</h2>
          <div class="steps">
            {workflow.steps.map((step, index) => (
              <StepSection
                number={index + 1}
                title={step.title}
                content={step.content}
                why={step.why}
                expectedResult={step.expectedResult}
                code={step.code}
              />
            ))}
          </div>
        </div>

        <div class="guide-section" id="architecture">
          <h2>Workflow architecture</h2>
          <p>{workflow.architecture}</p>
          <ArchitectureDiagram tools={workflow.tools} />
        </div>

        <div class="guide-section" id="result">
          <h2>Final result</h2>
          <p>{workflow.result}</p>

          {workflow.nextSteps.length > 0 && (
            <div class="next-steps">
              <p class="next-steps-label">Possible Next Steps</p>
              <ul class="next-steps-list">
                {workflow.nextSteps.map((step) => <li>{step}</li>)}
              </ul>
            </div>
          )}
        </div>

        {workflow.troubleshooting.length > 0 && (
          <div class="guide-section" id="troubleshooting">
            <h2>Troubleshooting</h2>
            <div class="troubleshooting-list">
              {workflow.troubleshooting.map((item) => (
                <details class="trouble-item">
                  <summary>{item.issue}</summary>
                  <div class="trouble-body">
                    <p><span class="trouble-label">Cause</span>{item.cause}</p>
                    <p><span class="trouble-label">Fix</span>{item.fix}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )}
      </article>

      <div class="toc-sidebar-slot">
        <TableOfContents items={tocItems} />
      </div>
    </div>
  </section>

  <RelatedWorkflows workflows={related} />
</main>

<Footer />

</BaseLayout>

<style>
  .guide {
    padding: var(--space-6) 0;
  }

  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 220px;
    gap: var(--space-5);
    align-items: start;
  }

  .guide-layout > article {
    min-width: 0;
  }

  .toc-mobile-slot :global(.toc-desktop) {
    display: none;
  }

  .guide-section {
    margin-bottom: var(--space-6);
  }

  .guide-section h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
  }

  .before-you-begin {
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .before-you-begin p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .before-label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-muted);
    margin-bottom: .4rem;
  }

  .prereq-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .6rem;
    padding-left: 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .prereq-list li {
    position: relative;
    padding-left: 1.6rem;
  }

  .prereq-list li::before {
    content: "\2713";
    position: absolute;
    left: 0;
    top: 0;
    width: 1.15rem;
    height: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .7rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(255, 107, 0, .12);
    border: 1px solid var(--accent);
    border-radius: 4px;
  }

  .steps {
    border-top: 1px solid var(--border);
  }

  .next-steps {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .next-steps-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: var(--space-2);
  }

  .next-steps-list {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .next-steps-list li {
    position: relative;
    padding-left: 1.25rem;
  }

  .next-steps-list li::before {
    content: "\2192";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .troubleshooting-list {
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .trouble-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow: hidden;
  }

  .trouble-item summary {
    cursor: pointer;
    padding: 1rem var(--space-3);
    font-weight: 600;
    font-size: var(--fs-sm);
    list-style: none;
  }

  .trouble-item summary::-webkit-details-marker {
    display: none;
  }

  .trouble-item summary::before {
    content: "+";
    margin-right: .6rem;
    color: var(--accent);
    font-weight: 700;
  }

  .trouble-item[open] summary::before {
    content: "\2013";
  }

  .trouble-body {
    padding: 0 var(--space-3) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .trouble-body p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .trouble-label {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--accent);
    margin-right: .4rem;
  }

  @media (max-width: 900px) {
    .guide-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc-sidebar-slot {
      display: none;
    }
  }
</style>
