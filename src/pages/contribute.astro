---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CodeBlock from "../components/content/CodeBlock.astro";
import { getAllCategories } from "../lib/categories.js";

const categories = await getAllCategories();

const contributeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://workflowvault.dev"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contribute",
        "item": "https://workflowvault.dev/contribute"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Community Blueprint Submission & Verification Standards — Workflow Vault",
    "description": "Guidelines and schema generator for submitting production-grade AI and automation blueprints to Workflow Vault."
  }
];

const tiers = [
  {
    level: "Tier 1: Generated Draft",
    badge: "UNVERIFIED",
    badgeClass: "badge-draft",
    desc: "AI or community-submitted template with standard frontmatter structure, but not yet reviewed or run by our engineering team."
  },
  {
    level: "Tier 2: Code Reviewed",
    badge: "REVIEWED",
    badgeClass: "badge-reviewed",
    desc: "Code syntax, security risks (HMAC verification, secret protection), and documentation reviewed by a maintainer."
  },
  {
    level: "Tier 3: Hardware Tested",
    badge: "TESTED",
    badgeClass: "badge-tested",
    desc: "Successfully deployed and run in a live environment (VPS, Docker, or edge worker) with real webhooks."
  },
  {
    level: "Tier 4: Production Verified",
    badge: "VERIFIED",
    badgeClass: "badge-verified",
    desc: "Battle-tested with high throughput, stress testing, edge-case failure handling, and full troubleshooting guides."
  }
];
---

<BaseLayout
  title="Contribute & Verify Blueprints — Workflow Vault"
  description="Submit your production-ready automation workflows to Workflow Vault. Review our 4-tier verification standard and generate formatted blueprint JSON/Markdown."
  schema={contributeSchema}
>

<Header />

<main class="contribute-page">
  <!-- Hero Section -->
  <section class="contribute-hero">
    <div class="container">
      <div class="section-tag">
        <span class="tag-dot"></span>
        <span>OPEN SOURCE AUTOMATION BLUEPRINTS</span>
      </div>
      <h1>Contribute to Workflow Vault</h1>
      <p class="subtitle">
        Help us build the most reliable, fluff-free repository of automation blueprints. Every submitted workflow is validated against our strict testing and security standards.
      </p>
    </div>
  </section>

  <!-- Standards & Tiers -->
  <section class="contribute-section">
    <div class="container">
      <div class="section-heading">
        <span class="mini-tag">OUR TESTING STANDARD</span>
        <h2>The 4-Tier Verification Hierarchy</h2>
        <p class="heading-sub">We never claim a workflow is verified unless it has been deployed and tested against real APIs.</p>
      </div>

      <div class="grid tiers-grid">
        {tiers.map((tier) => (
          <div class="card tier-card">
            <div class="tier-top">
              <span class={`tier-badge ${tier.badgeClass}`}>{tier.badge}</span>
            </div>
            <h3>{tier.level}</h3>
            <p>{tier.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Submission Generator -->
  <section class="contribute-section" id="generator">
    <div class="container">
      <div class="section-heading">
        <span class="mini-tag">SUBMISSION GENERATOR</span>
        <h2>Interactive Blueprint Formatter</h2>
        <p class="heading-sub">Fill out the blueprint details below to generate a valid Content Layer JSON/Markdown file ready for GitHub Pull Request.</p>
      </div>

      <div class="generator-grid">
        
        <!-- Form Fields -->
        <div class="gen-form-card">
          <form id="blueprint-form" class="bp-form" onsubmit="return false;">
            <div class="form-row">
              <div class="form-group flex-1">
                <label for="bp-title">Workflow Title *</label>
                <input type="text" id="bp-title" name="title" class="text-input" placeholder="e.g. Stripe Webhook to PostgreSQL Sync" required />
              </div>
              <div class="form-group flex-1">
                <label for="bp-category">Category *</label>
                <select id="bp-category" name="category" class="custom-select" required>
                  {categories.map((c) => (
                    <option value={c.name}>{c.name}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="bp-desc">Short Description (1-2 sentences) *</label>
              <input type="text" id="bp-desc" name="description" class="text-input" placeholder="e.g. Capture Stripe checkout events, verify HMAC signatures, and store customers in PostgreSQL." required />
            </div>

            <div class="form-row">
              <div class="form-group flex-1">
                <label for="bp-difficulty">Difficulty Level</label>
                <select id="bp-difficulty" name="difficulty" class="custom-select">
                  <option value="Beginner">Beginner</option>
                  <option value="Intermediate" selected>Intermediate</option>
                  <option value="Advanced">Advanced</option>
                </select>
              </div>
              <div class="form-group flex-1">
                <label for="bp-time">Estimated Reading/Setup Time</label>
                <input type="text" id="bp-time" name="readingTime" class="text-input" value="15 min read" />
              </div>
            </div>

            <div class="form-group">
              <label for="bp-tools">Tools &amp; Services (comma separated) *</label>
              <input type="text" id="bp-tools" name="tools" class="text-input" placeholder="Stripe, Node.js, Express, PostgreSQL, Docker" required />
            </div>

            <div class="form-group">
              <label for="bp-prereqs">Prerequisites (one per line) *</label>
              <textarea id="bp-prereqs" name="prerequisites" class="text-area" rows="3" placeholder="Node.js 20+ installed&#10;Stripe Developer account with API keys&#10;Running PostgreSQL database instance"></textarea>
            </div>

            <div class="form-group">
              <label for="bp-overview">Workflow Architecture Overview *</label>
              <textarea id="bp-overview" name="overview" class="text-area" rows="4" placeholder="Explain the high-level architecture, how webhooks travel from the source to destination, and where security safeguards are enforced."></textarea>
            </div>
          </form>
        </div>

        <!-- Generated Markdown / JSON Output -->
        <div class="gen-output-card">
          <div class="output-top-bar">
            <span class="file-label">src/content/workflows/your-workflow.json</span>
            <div class="output-btns">
              <button type="button" class="btn-sm" id="btn-copy-bp">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span id="copy-bp-text">Copy JSON</span>
              </button>
              <a href="https://github.com/lubinda2003/Workflow-valt/fork" target="_blank" rel="noopener noreferrer" class="btn-sm primary">
                Submit PR on GitHub
              </a>
            </div>
          </div>

          <div class="code-box">
            <pre class="code-pre"><code id="bp-code-view" class="code-stream">// Generated schema will appear here in real time...</code></pre>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Step-by-Step GitHub Contribution Guide -->
  <section class="contribute-section">
    <div class="container">
      <div class="section-heading">
        <span class="mini-tag">SUBMISSION LIFECYCLE</span>
        <h2>How to Submit via GitHub Pull Request</h2>
        <p class="heading-sub">Our repository uses standard Astro Content Collections. Follow these 4 steps to get your blueprint merged.</p>
      </div>

      <div class="steps-flow">
        <div class="flow-step">
          <div class="flow-num">01</div>
          <div class="flow-body">
            <strong>Fork &amp; Clone the Repository</strong>
            <p>Fork <code>lubinda2003/Workflow-valt</code> and clone it to your local development machine.</p>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-num">02</div>
          <div class="flow-body">
            <strong>Add Your JSON Schema</strong>
            <p>Create a new JSON definition in <code>src/content/workflows/[slug].json</code> following the schema generated above.</p>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-num">03</div>
          <div class="flow-body">
            <strong>Run Local Type Checks &amp; Build</strong>
            <p>Run <code>npm run build</code> to ensure your guide conforms to the Astro Content Schema and generates static pages without warnings.</p>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-num">04</div>
          <div class="flow-body">
            <strong>Open Pull Request for Verification</strong>
            <p>Submit your PR. A maintainer will review the code, test execution, and assign the appropriate verification tier.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer />

</BaseLayout>

<script>
  function setupBlueprintGenerator() {
    const form = document.getElementById("blueprint-form") as HTMLFormElement | null;
    const codeView = document.getElementById("bp-code-view");
    const copyBtn = document.getElementById("btn-copy-bp");
    const copyText = document.getElementById("copy-bp-text");

    function slugify(text: string) {
      return text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)+/g, "");
    }

    function renderOutput() {
      if (!form || !codeView) return;
      const fd = new FormData(form);

      const title = (fd.get("title") as string) || "My Automated Workflow";
      const slug = slugify(title);
      const category = (fd.get("category") as string) || "APIs & Webhooks";
      const description = (fd.get("description") as string) || "Brief summary of what this automation achieves in production.";
      const difficulty = (fd.get("difficulty") as string) || "Intermediate";
      const readingTime = (fd.get("readingTime") as string) || "15 min read";
      const toolsStr = (fd.get("tools") as string) || "Node.js, Docker, Webhooks";
      const tools = toolsStr.split(",").map((t) => t.trim()).filter(Boolean);
      
      const prereqsStr = (fd.get("prerequisites") as string) || "Docker installed on your machine\nValid API credentials";
      const prerequisites = prereqsStr.split("\n").map((p) => p.trim()).filter(Boolean);

      const overview = (fd.get("overview") as string) || "Architecture overview detailing the trigger event, transformation, and destination action.";

      const schemaObj = {
        title,
        slug,
        category,
        description,
        difficulty,
        readingTime,
        tools,
        whatYoullBuild: `You will build and deploy a resilient ${title} pipeline with complete error handling and status logging.`,
        overview,
        prerequisites,
        architecture: `${tools[0] || "Trigger Event"} -> Transformation / Security Verification -> ${tools[1] || "Target API / Database"}`,
        steps: [
          {
            title: "Phase 1: Environment Setup & Credentials",
            why: "Establishes secure, isolated variables before processing incoming webhook payloads.",
            content: "Create a local workspace and define required API tokens in .env.",
            code: {
              language: "bash",
              content: "mkdir automation && cd automation\ncp .env.example .env"
            },
            expectedResult: "A clean directory structure with environment keys ready."
          },
          {
            title: "Phase 2: Build & Verify Handler",
            why: "Ensures incoming payloads match cryptographic signatures before writing to storage.",
            content: "Implement the webhook receiver and verify request headers.",
            code: {
              language: "typescript",
              content: "// Webhook verification handler logic here"
            },
            expectedResult: "Webhook tests return 200 OK."
          }
        ],
        result: `A fully operational ${title} automation running 24/7.`,
        nextSteps: [
          "Set up uptime alerting via Uptime Kuma or BetterStack",
          "Add automated retries on rate limits"
        ],
        troubleshooting: [
          {
            issue: "Webhook returns 401 Unauthorized",
            cause: "Secret key in .env does not match the webhook provider endpoint signing secret.",
            fix: "Verify the webhook signing secret in your provider dashboard and restart the container."
          }
        ],
        glossary: [
          {
            term: "Webhook",
            definition: "An automated HTTP POST request sent by an external service when a specific event occurs."
          }
        ]
      };

      codeView.textContent = JSON.stringify(schemaObj, null, 2);
    }

    if (form) {
      form.addEventListener("input", renderOutput);
      form.addEventListener("change", renderOutput);
    }

    if (copyBtn && codeView) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(codeView.textContent || "");
          if (copyText) copyText.textContent = "Copied!";
          setTimeout(() => {
            if (copyText) copyText.textContent = "Copy JSON";
          }, 2000);
        } catch (e) {
          // fallback
        }
      });
    }

    renderOutput();
  }

  setupBlueprintGenerator();
  document.addEventListener("astro:page-load", setupBlueprintGenerator);
</script>

<style>
  .contribute-hero {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(249, 115, 22, 0.08) 0%, transparent 65%);
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .contribute-hero h1 {
    font-size: var(--fs-2xl);
    line-height: 1.15;
    max-width: 820px;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .subtitle {
    max-width: 720px;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .contribute-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-heading {
    max-width: 680px;
    margin-bottom: 2rem;
  }

  .mini-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .section-heading h2 {
    font-size: var(--fs-xl);
    margin-bottom: 0.35rem;
  }

  .heading-sub {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: 0;
  }

  /* Verification Tiers Grid */
  .tiers-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 1024px) {
    .tiers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .tiers-grid {
      grid-template-columns: 1fr;
    }
  }

  .tier-card {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .tier-top {
    margin-bottom: 0.75rem;
  }

  .tier-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
    letter-spacing: 0.06em;
  }

  .badge-draft {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }

  .badge-reviewed {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .badge-tested {
    background: rgba(249, 115, 22, 0.15);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .badge-verified {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .tier-card h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text);
  }

  .tier-card p {
    font-size: var(--fs-2xs);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Generator Grid */
  .generator-grid {
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 1040px) {
    .generator-grid {
      grid-template-columns: 1fr;
    }
  }

  .gen-form-card,
  .gen-output-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .bp-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: flex;
    gap: 1rem;
  }

  .flex-1 {
    flex: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: var(--fs-2xs);
    font-weight: 700;
    color: var(--text);
  }

  .text-input,
  .custom-select,
  .text-area {
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text);
    font-size: var(--fs-xs);
    font-family: inherit;
    transition: var(--transition);
  }

  .text-input:focus,
  .custom-select:focus,
  .text-area:focus {
    outline: none;
    border-color: var(--accent);
  }

  .output-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .file-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-subtle);
  }

  .output-btns {
    display: flex;
    gap: 0.5rem;
  }

  .btn-sm {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.65rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    font-size: var(--fs-2xs);
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .btn-sm:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .btn-sm.primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .btn-sm.primary:hover {
    background: var(--accent-hover);
  }

  .code-box {
    background: var(--code-bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    max-height: 520px;
    overflow-y: auto;
  }

  .code-pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    line-height: 1.5;
    color: var(--text-muted);
    white-space: pre-wrap;
  }

  /* Steps Flow */
  .steps-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .steps-flow {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .steps-flow {
      grid-template-columns: 1fr;
    }
  }

  .flow-step {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .flow-num {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.6;
  }

  .flow-body strong {
    display: block;
    font-size: var(--fs-xs);
    color: var(--text);
    margin-bottom: 0.3rem;
  }

  .flow-body p {
    font-size: var(--fs-2xs);
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }
</style>
