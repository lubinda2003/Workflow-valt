---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CodeBlock from "../components/content/CodeBlock.astro";
import { getAllWorkflows } from "../lib/workflows.js";

const workflows = await getAllWorkflows();

const builderSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://workflowvault.dev"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Configurator",
        "item": "https://workflowvault.dev/builder"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Automation Stack Configurator & Blueprint Builder",
    "description": "Configure, customize, and generate production-ready Docker Compose files, .env files, and bootstrap scripts for self-hosted and cloud automations.",
    "applicationCategory": "DeveloperApplication"
  }
];
---

<BaseLayout
  title="Stack Configurator & Blueprint Builder — Workflow Vault"
  description="Generate custom, ready-to-run Docker Compose stacks, environment files, and infrastructure configs for n8n, PostgreSQL, Redis, Caddy, Cloudflare Workers, and AI agents."
  schema={builderSchema}
>

<Header />

<main class="builder-page">
  <section class="builder-hero">
    <div class="container">
      <div class="section-tag">
        <span class="tag-dot"></span>
        <span>INTERACTIVE STACK GENERATOR</span>
      </div>
      <h1>Automation Stack Configurator</h1>
      <p class="subtitle">
        Select your automation engine, database, proxy, and hardware target. Instantly generate customized, battle-tested <code>docker-compose.yml</code>, <code>.env</code>, and 1-click deployment scripts.
      </p>
    </div>
  </section>

  <section class="builder-workspace">
    <div class="container">
      <div class="builder-grid">
        
        <!-- Interactive Controls Form (Left Column) -->
        <div class="config-controls-card">
          <div class="panel-header">
            <span class="panel-step">STEP 1</span>
            <h2>Configure Your Pipeline</h2>
          </div>

          <form id="stack-form" class="config-form" onsubmit="return false;">
            <!-- Target Environment -->
            <div class="form-group">
              <label class="group-label">Hardware &amp; Target</label>
              <div class="radio-cards-grid">
                <label class="radio-card">
                  <input type="radio" name="hardware" value="cloud-vps" checked />
                  <div class="radio-card-content">
                    <div class="radio-head">
                      <strong>Cloud VPS</strong>
                      <span class="price-chip">~$4/mo</span>
                    </div>
                    <span>Dedicated Linux VM with public IP &amp; SSL (24/7 webhooks)</span>
                  </div>
                </label>

                <label class="radio-card">
                  <input type="radio" name="hardware" value="local-pc" />
                  <div class="radio-card-content">
                    <div class="radio-head">
                      <strong>Local PC / Mac</strong>
                      <span class="price-chip free">$0</span>
                    </div>
                    <span>Docker Desktop or local terminal on your everyday machine</span>
                  </div>
                </label>

                <label class="radio-card">
                  <input type="radio" name="hardware" value="rpi" />
                  <div class="radio-card-content">
                    <div class="radio-head">
                      <strong>Raspberry Pi / Home Lab</strong>
                      <span class="price-chip free">$0</span>
                    </div>
                    <span>ARM64 home server or low-power always-on board</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Core Automation Engine -->
            <div class="form-group">
              <label class="group-label">Automation Engine</label>
              <select class="custom-select" name="engine" id="engine-select">
                <option value="n8n" selected>n8n (Self-Hosted Community Edition)</option>
                <option value="cloudflare">Cloudflare Edge Worker (Serverless TypeScript)</option>
                <option value="express-webhook">Express.js Custom Webhook Listener</option>
                <option value="github-actions">GitHub Actions CI/CD Pipeline</option>
              </select>
            </div>

            <!-- Domain / Hostname -->
            <div class="form-group" id="domain-group">
              <label class="group-label" for="domain-input">Custom Domain / Hostname</label>
              <input
                type="text"
                id="domain-input"
                name="domain"
                class="text-input"
                placeholder="automation.yourdomain.com"
                value="automation.example.com"
              />
              <span class="input-hint">Used for automatic HTTPS certificates and webhook URL routing.</span>
            </div>

            <!-- Database Option -->
            <div class="form-group">
              <label class="group-label">Data Persistence</label>
              <div class="option-pills">
                <label class="pill-checkbox">
                  <input type="radio" name="database" value="postgres" checked />
                  <span>PostgreSQL 16 (Recommended for scale)</span>
                </label>
                <label class="pill-checkbox">
                  <input type="radio" name="database" value="sqlite" />
                  <span>SQLite (Lightweight, single-file)</span>
                </label>
              </div>
            </div>

            <!-- Additional Add-ons -->
            <div class="form-group">
              <label class="group-label">Add-ons &amp; Infrastructure Services</label>
              <div class="checkbox-list">
                <label class="check-item">
                  <input type="checkbox" name="addon_caddy" checked />
                  <div>
                    <strong>Caddy Reverse Proxy</strong>
                    <span>Automated SSL certificate generation via Let's Encrypt</span>
                  </div>
                </label>
                <label class="check-item">
                  <input type="checkbox" name="addon_redis" />
                  <div>
                    <strong>Redis Cache / Queue</strong>
                    <span>High-throughput execution queueing and webhook buffering</span>
                  </div>
                </label>
                <label class="check-item">
                  <input type="checkbox" name="addon_qdrant" />
                  <div>
                    <strong>Qdrant Vector Database</strong>
                    <span>Local vector embeddings for AI memory and RAG agents</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- AI Engine & Model Credentials -->
            <div class="form-group">
              <label class="group-label">AI Agent Provider (Optional Injection)</label>
              <select class="custom-select" name="ai_provider" id="ai-select">
                <option value="none">None (Standard Rule-Based Automation)</option>
                <option value="gemini" selected>Google Gemini (Gemini 2.5 Flash / Pro)</option>
                <option value="anthropic">Anthropic (Claude 3.5 Sonnet)</option>
                <option value="openai">OpenAI (GPT-4o / Embeddings)</option>
                <option value="ollama">Ollama (Local Private LLMs on GPU/CPU)</option>
              </select>
            </div>
          </form>
        </div>

        <!-- Generated Artifacts & Code Output (Right Column) -->
        <div class="config-output-card">
          <div class="panel-header output-header">
            <div>
              <span class="panel-step">STEP 2</span>
              <h2>Generated Configuration</h2>
            </div>
            
            <div class="output-actions">
              <button type="button" class="action-btn" id="btn-copy-active">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copy-btn-text">Copy Code</span>
              </button>

              <button type="button" class="action-btn primary" id="btn-download-bundle">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Bundle</span>
              </button>
            </div>
          </div>

          <!-- Tab Bar for Output Files -->
          <div class="tab-bar">
            <button type="button" class="tab-btn active" data-tab="compose">docker-compose.yml</button>
            <button type="button" class="tab-btn" data-tab="env">.env.example</button>
            <button type="button" class="tab-btn" data-tab="caddyfile">Caddyfile</button>
            <button type="button" class="tab-btn" data-tab="bash">deploy.sh</button>
          </div>

          <!-- Code Display Box -->
          <div class="code-viewport">
            <pre class="generated-pre"><code id="code-display" class="generated-code"># Generating stack configuration...</code></pre>
          </div>

          <!-- Quick Terminal 1-Liner -->
          <div class="quick-terminal-box">
            <div class="terminal-top">
              <span class="terminal-title">QUICK 1-LINER INSTALL (VPS OR LOCAL)</span>
              <button type="button" class="terminal-copy-btn" id="btn-copy-command">Copy Command</button>
            </div>
            <div class="terminal-command-wrap">
              <span class="prompt-sym">$</span>
              <code id="terminal-command">mkdir -p automation-stack &amp;&amp; cd automation-stack</code>
            </div>
          </div>

          <!-- Estimated Hardware & Cost Breakdown -->
          <div class="specs-summary-card">
            <div class="spec-col">
              <span class="spec-label">ESTIMATED RAM</span>
              <strong id="spec-ram" class="spec-value">~1.2 GB RAM</strong>
            </div>
            <div class="spec-col">
              <span class="spec-label">ESTIMATED COST</span>
              <strong id="spec-cost" class="spec-value">$4 - $6 / mo</strong>
            </div>
            <div class="spec-col">
              <span class="spec-label">SECURITY</span>
              <strong id="spec-sec" class="spec-value">Auto-SSL + Isolated Net</strong>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>
</main>

<Footer />

</BaseLayout>

<script>
  function setupConfigurator() {
    const form = document.getElementById("stack-form") as HTMLFormElement | null;
    const codeDisplay = document.getElementById("code-display");
    const tabBtns = document.querySelectorAll(".tab-btn");
    const copyBtn = document.getElementById("btn-copy-active");
    const copyBtnText = document.getElementById("copy-btn-text");
    const downloadBtn = document.getElementById("btn-download-bundle");
    const terminalCmd = document.getElementById("terminal-command");
    const copyCmdBtn = document.getElementById("btn-copy-command");
    const specRam = document.getElementById("spec-ram");
    const specCost = document.getElementById("spec-cost");

    let currentTab = "compose";
    let generatedFiles: Record<string, string> = {};

    function generateConfiguration() {
      if (!form) return;

      const formData = new FormData(form);
      const hardware = formData.get("hardware") as string;
      const engine = formData.get("engine") as string;
      const domain = (formData.get("domain") as string) || "automation.example.com";
      const database = formData.get("database") as string;
      const addonCaddy = formData.get("addon_caddy") === "on";
      const addonRedis = formData.get("addon_redis") === "on";
      const addonQdrant = formData.get("addon_qdrant") === "on";
      const aiProvider = formData.get("ai_provider") as string;

      // Calculate RAM & Cost metrics
      let ramUsage = 0.5; // base
      if (engine === "n8n") ramUsage += 0.5;
      if (database === "postgres") ramUsage += 0.3;
      if (addonRedis) ramUsage += 0.2;
      if (addonQdrant) ramUsage += 0.5;
      if (aiProvider === "ollama") ramUsage += 3.5;

      let costStr = "$4 - $6 / mo (VPS)";
      if (hardware === "local-pc" || hardware === "rpi") {
        costStr = "$0 / mo (Your Hardware)";
      } else if (engine === "cloudflare") {
        costStr = "Free Tier (100k req/day)";
      }

      if (specRam) specRam.textContent = `~${ramUsage.toFixed(1)} GB RAM`;
      if (specCost) specCost.textContent = costStr;

      // 1. Generate docker-compose.yml
      let composeServices: string[] = [];
      let volumesList: string[] = [];

      if (engine === "n8n") {
        composeServices.push(`  n8n:
    image: n8nio/n8n:latest
    container_name: n8n_engine
    restart: unless-stopped
    ports:
      - "127.0.0.1:5678:5678"
    environment:
      - N8N_HOST=\${DOMAIN_NAME:-${domain}}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - WEBHOOK_URL=https://\${DOMAIN_NAME:-${domain}}/
      - GENERIC_TIMEZONE=\${GENERIC_TIMEZONE:-UTC}
      - DB_TYPE=${database === "postgres" ? "postgresdb" : "sqlite"}
${database === "postgres" ? `      - DB_POSTGRESDB_DATABASE=\${POSTGRES_DB:-n8n}
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_USER=\${POSTGRES_USER:-n8n_user}
      - DB_POSTGRESDB_PASSWORD=\${POSTGRES_PASSWORD}` : ""}
${addonRedis ? "      - EXECUTIONS_MODE=queue\n      - QUEUE_BULL_REDIS_HOST=redis" : ""}
    volumes:
      - n8n_data:/home/node/.n8n
    ${database === "postgres" ? "depends_on:\n      - postgres" : ""}`);
        volumesList.push("  n8n_data:");
      } else if (engine === "express-webhook") {
        composeServices.push(`  webhook-api:
    build: .
    container_name: webhook_listener
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      - PORT=3000
      - NODE_ENV=production
      - DATABASE_URL=postgresql://\${POSTGRES_USER:-app_user}:\${POSTGRES_PASSWORD}@postgres:5432/\${POSTGRES_DB:-app_db}
    depends_on:
      - postgres`);
      } else if (engine === "cloudflare") {
        composeServices.push(`  # Cloudflare Workers run natively on the edge (no Docker container required)
  # To test locally with Miniflare:
  # npm run dev -- --remote`);
      }

      if (database === "postgres") {
        composeServices.push(`  postgres:
    image: postgres:16-alpine
    container_name: postgres_db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=\${POSTGRES_USER:-n8n_user}
      - POSTGRES_PASSWORD=\${POSTGRES_PASSWORD}
      - POSTGRES_DB=\${POSTGRES_DB:-n8n}
    volumes:
      - postgres_data:/var/lib/postgresql/data`);
        volumesList.push("  postgres_data:");
      }

      if (addonRedis) {
        composeServices.push(`  redis:
    image: redis:7-alpine
    container_name: redis_cache
    restart: unless-stopped
    command: redis-server --save 60 1 --loglevel warning
    volumes:
      - redis_data:/data`);
        volumesList.push("  redis_data:");
      }

      if (addonQdrant) {
        composeServices.push(`  qdrant:
    image: qdrant/qdrant:latest
    container_name: qdrant_vector
    restart: unless-stopped
    ports:
      - "127.0.0.1:6333:6333"
    volumes:
      - qdrant_data:/qdrant/storage`);
        volumesList.push("  qdrant_data:");
      }

      if (addonCaddy && hardware !== "local-pc") {
        composeServices.push(`  caddy:
    image: caddy:2-alpine
    container_name: caddy_proxy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - ${engine === "n8n" ? "n8n" : (engine === "express-webhook" ? "webhook-api" : "postgres")}`);
        volumesList.push("  caddy_data:\n  caddy_config:");
      }

      const composeFile = `services:\n${composeServices.join("\n\n")}\n\nvolumes:\n${volumesList.join("\n")}`;

      // 2. Generate .env.example
      let envVars = [
        `# Automation Stack Configuration`,
        `DOMAIN_NAME=${domain}`,
        `GENERIC_TIMEZONE=UTC`,
        `POSTGRES_USER=vault_user`,
        `POSTGRES_PASSWORD=replace_with_secure_alphanumeric_password_here`,
        `POSTGRES_DB=vault_db`
      ];

      if (aiProvider === "gemini") {
        envVars.push(`GEMINI_API_KEY=your_gemini_api_key_here`);
      } else if (aiProvider === "anthropic") {
        envVars.push(`ANTHROPIC_API_KEY=your_claude_api_key_here`);
      } else if (aiProvider === "openai") {
        envVars.push(`OPENAI_API_KEY=your_openai_api_key_here`);
      }

      const envFile = envVars.join("\n");

      // 3. Generate Caddyfile
      const caddyFile = `${domain} {
    encode gzip zstd
    
    # Reverse proxy to internal automation engine
    reverse_proxy ${engine === "n8n" ? "n8n:5678" : "webhook-api:3000"} {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}`;

      // 4. Generate deploy.sh
      const deployFile = `#!/usr/bin/env bash
# Workflow Vault Automated Stack Deployer
set -euo pipefail

echo "==> Preparing automation workspace..."
mkdir -p ./automation-stack
cd ./automation-stack

echo "==> Writing .env and configuration..."
if [ ! -f .env ]; then
  cp .env.example .env
  echo "Created .env file. Please edit with your passwords before running."
fi

echo "==> Pulling Docker containers & starting stack..."
docker compose pull
docker compose up -d

echo "==> Deployment Complete!"
docker compose ps`;

      generatedFiles = {
        compose: composeFile,
        env: envFile,
        caddyfile: caddyFile,
        bash: deployFile
      };

      updateActiveView();

      if (terminalCmd) {
        terminalCmd.textContent = `git clone https://github.com/lubinda2003/Workflow-valt.git && cd Workflow-valt && docker compose up -d`;
      }
    }

    function updateActiveView() {
      if (!codeDisplay) return;
      codeDisplay.textContent = generatedFiles[currentTab] || "# No configuration generated";
    }

    // Tab buttons
    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentTab = btn.getAttribute("data-tab") || "compose";
        updateActiveView();
      });
    });

    // Copy Code button
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const text = generatedFiles[currentTab] || "";
        try {
          await navigator.clipboard.writeText(text);
          if (copyBtnText) copyBtnText.textContent = "Copied!";
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = "Copy Code";
          }, 2000);
        } catch (e) {
          // fallback
        }
      });
    }

    // Copy Terminal Command
    if (copyCmdBtn && terminalCmd) {
      copyCmdBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(terminalCmd.textContent || "");
          copyCmdBtn.textContent = "Copied!";
          setTimeout(() => {
            copyCmdBtn.textContent = "Copy Command";
          }, 2000);
        } catch (e) {
          // fallback
        }
      });
    }

    // Download Bundle
    if (downloadBtn) {
      downloadBtn.addEventListener("click", () => {
        const blob = new Blob([generatedFiles.compose || ""], { type: "text/yaml" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "docker-compose.yml";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Live form updates
    if (form) {
      form.addEventListener("change", generateConfiguration);
      form.addEventListener("input", generateConfiguration);
    }

    generateConfiguration();
  }

  setupConfigurator();
  document.addEventListener("astro:page-load", setupConfigurator);
</script>

<style>
  .builder-hero {
    padding: 3.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(249, 115, 22, 0.08) 0%, transparent 65%);
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .builder-hero h1 {
    font-size: var(--fs-2xl);
    line-height: 1.15;
    max-width: 820px;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
  }

  .subtitle {
    max-width: 720px;
    font-size: clamp(0.9375rem, 1.5vw, 1.0625rem);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .builder-workspace {
    padding: 3rem 0 5rem;
  }

  .builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 1040px) {
    .builder-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Cards */
  .config-controls-card,
  .config-output-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .panel-header {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1rem;
  }

  .output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .panel-step {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .panel-header h2 {
    font-size: 1.25rem;
    margin: 0;
  }

  /* Form Elements */
  .config-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .group-label {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text);
  }

  .radio-cards-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .radio-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
  }

  .radio-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .radio-card input {
    margin-top: 0.25rem;
    accent-color: var(--accent);
  }

  .radio-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }

  .radio-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .radio-head strong {
    font-size: var(--fs-xs);
    color: var(--text);
  }

  .price-chip {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .price-chip.free {
    color: var(--accent);
    background: var(--accent-soft);
  }

